# Copia este fichero a .env y rellena los valores (pidelos al admin del Developer Space).
# .env esta en .gitignore y nunca se sube al repositorio.

# Backend del pipeline agentico (LangGraph). Tunel ngrok en la demo: caduca.
LANGGRAPH_URL=

# API key del LLM que usa el chat del Asistente (src/resolvers/claude.js)
LLM_API_KEY=

# Secreto del webtrigger de datos de demo (src/resolvers/seed.js)
SEED_SECRET=

# URL del webtrigger de datos de demo, si ya esta creado
SEED_WEBTRIGGER_URL=
