NODE_ENV=local
PORT=8000
SERVICE_PORT=8002
API_VERSION=v1
APP_NAME=INTEGRATION-SERVICE
APP_DESCRIPTION=Integration service for ITSM Ticketing Agents
HEALTH_CHECK_PATH=/health
LOG_LEVEL=info
LOG_PRETTY_PRINT=true

MONGODB_USERNAME=local
MONGODB_PASSWORD=local
MONGODB_HOST=mongo
MONGODB_PORT=27017
MONGODB_PORT_HOST=27019
MONGODB_DATABASE=bkt-integration-service
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=5

API_KEY=local-dev-api-key
API_KEY_HEADER=X-API-KEY

CORS_ORIGIN=*
CORS_CREDENTIALS=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

ORCHESTRATOR_BASE_URL=http://host.docker.internal:8001
ORCHESTRATOR_ENDPOINT=/api/v1/orchestrator/dispatch
ORCHESTRATOR_ROLE=agentic-orchestrator-application
ORCHESTRATOR_TIMEOUT_MS=30000

ATTACHMENT_BYTES_LIMIT=4194304
JIRA_BASE_URL=
JIRA_USER=
JIRA_PASSWORD=

MESH_ID=6a323e68-6f87-403a-a87d-72da69fcde0d
ORIGINAL_TICKET_COLLECTION_NAME=itsm_tickets
PROCESSED_TICKET_COLLECTION_NAME=tickets
EXECUTIONS_COLLECTION_NAME=executions
MAPPINGS_COLLECTION_NAME=mappings
