# Local environment template for the reduced runtime.

APP_NAME=agentic-core
APP_VERSION=0.5.0
ENVIRONMENT=local

APP_HOST_PORT=8001
SERVER__DEBUG=false
LOGGING__LEVEL=INFO
LOGGING__JSON_LOGS=false

MONGO_VERSION=8.0
MONGO_HOST_PORT=27018
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=
MONGODB__DSN=
MONGODB__APP_NAME=agentic-core
MONGODB__SERVER_SELECTION_TIMEOUT_MS=3000

REDIS_VERSION=8.6.1
REDIS_HOST_PORT=6380
REDIS_PASSWORD=
REDIS__URL=
REDIS__KEY_PREFIX=agentic-core
REDIS__SOCKET_TIMEOUT_SECONDS=5
REDIS__HEALTHCHECK_INTERVAL_SECONDS=30

AUTH__ENCRYPTION_KEY=

CACHE__ENABLED=false
CACHE__DEFAULT_TTL_SECONDS=60
CACHE__AGENT_TTL_SECONDS=60
CACHE__TOOL_TTL_SECONDS=300
CACHE__MCP_TTL_SECONDS=300
CACHE__MODEL_TTL_SECONDS=300
CACHE__PROVIDER_TTL_SECONDS=300

OBSERVABILITY__OTLP_ENDPOINT=http://phoenix:6006
OBSERVABILITY__SERVICE_NAME=agentic-core
PHOENIX_HOST_PORT=6007

ORCHESTRATOR__DEFAULT_MODEL=
ORCHESTRATOR__INSTRUCTIONS=

RESPONSES_AZURE_ENDPOINT=
OPENAI_AZURE_API_KEY=

CORTEX_PROXY_ENABLED=false
CORTEX_PROXY_BASE_URL=http://bktcortexproxyllm:8010/api/v1/llm
CORTEX_PROXY_PROVIDER=azure
CORTEX_PROXY_API_KEY=

AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

WATSONX_URL=
WATSONX_APIKEY=
WATSONX_PROJECT_ID=
