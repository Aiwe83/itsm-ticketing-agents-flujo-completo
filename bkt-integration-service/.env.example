NODE_ENV=local
PORT=8000
API_VERSION=v1

MONGO_INITDB_ROOT_USERNAME=example_user
MONGO_INITDB_ROOT_PASSWORD=example_password
MONGODB_DATABASE=integration-service
MONGODB_HOST=localhost
MONGODB_USERNAME=example_user
MONGODB_PASSWORD=example_password
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=1

API_KEY_HEADER=x-api-key
API_KEY=change-me-to-a-long-random-secret

LOG_LEVEL=info
LOG_PRETTY_PRINT=true

CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=false

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

APP_NAME=INTEGRATION-SERVICE
APP_DESCRIPTION=INTEGRATION-SERVICE Jira integration service

HEALTH_CHECK_PATH=/health

ORCHESTRATOR_BASE_URL=http://orchestrator.local
ORCHESTRATOR_ENDPOINT=/api/v1/tickets
ORCHESTRATOR_ROLE=agentic-orchestrator-application

ATTACHMENT_BYTES_LIMIT=4194304
JIRA_BASE_URL=http://jira.example.local
JIRA_USER=example_user
JIRA_PASSWORD=example_password

MESH_ID=00000000-0000-0000-0000-000000000000

ORIGINAL_TICKET_COLLECTION_NAME=itsm_tickets
PROCESSED_TICKET_COLLECTION_NAME=tickets
EXECUTIONS_COLLECTION_NAME=executions
MAPPINGS_COLLECTION_NAME=mappings

