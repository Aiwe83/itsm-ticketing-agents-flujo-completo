{
  "name": "integration-service",
  "version": "1.0.0-SNAPSHOT",
  "description": "INTEGRATION-SERVICE Jira integration service",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --exit-child src/server.ts",
    "debug": "tsc && node --enable-source-maps --inspect-brk=0.0.0.0:9229 dist/server.js",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:e2e": "jest src/__tests__/e2e --coverage=false",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "db:ensure-indexes": "node dist/scripts/ensure-indexes.js",
    "db:migrate-mesh:dry-run": "node dist/scripts/migrate-mesh.js --mode=dry-run",
    "db:migrate-mesh:apply": "node dist/scripts/migrate-mesh.js --mode=apply --confirm=integration-service",
    "mappings:dry-run": "node dist/scripts/sync-mapping-catalog.js --mode=dry-run",
    "mappings:apply": "node dist/scripts/sync-mapping-catalog.js --mode=apply",
    "openapi:generate": "ts-node src/scripts/generate-openapi.ts",
    "openapi:check": "ts-node src/scripts/generate-openapi.ts --check",
    "openapi:lint": "redocly lint openapi.yaml --extends=minimal"
  },
  "keywords": [
    "express",
    "typescript",
    "mongodb",
    "jwt",
    "api",
    "rest",
    "itsm"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "got": "^14.6.3",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.2",
    "mammoth": "1.9.0",
    "mongoose": "^8.19.3",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.2",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "unpdf": "^1.8.1",
    "uuid": "^13.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@redocly/cli": "^2.45.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.0",
    "@types/supertest": "^6.0.3",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.2.0",
    "mongodb-memory-server": "^10.3.0",
    "openapi3-ts": "^4.6.1",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
