ira-triggers/openspec/specs/forge-trigger-flow-demo/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A destination that does not resolve is NETWORK, not HTTP; a 201 with nothing stored is APPLICATION; failures never propagate as exceptions."}, {"id": "bkt_jira_triggers_openspec_specs_forge_trigger_flow_demo_spec_offline_demo_runner", "label": "Offline demo runner and aggregate scenario registry", "file_type": "concept", "source_file": "bkt-jira-triggers/openspec/specs/forge-trigger-flow-demo/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs the whole path with no Forge session, Jira site, external service or network; exits non-zero on any failed scenario or leaked planted marker; scenarios that run until interrupted are excluded from the aggregate registry."}, {"id": "bkt_jira_triggers_openspec_specs_forge_trigger_flow_demo_spec_project_filter_expression", "label": "Project filter expression with onError, verified in both directions", "file_type": "rationale", "source_file": "bkt-jira-triggers/openspec/specs/forge-trigger-flow-demo/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The field read must first be confirmed in a real payload; onError must record failed evaluations rather than silently dropping events; the negative check is performed before the positive one."}, {"id": "bkt_jira_triggers_openspec_specs_forge_trigger_flow_demo_spec_allowlist_sanitisation", "label": "Allowlist sanitisation design (title as [redacted:N], actor as truncated hash, changelog field names only)", "file_type": "rationale", "source_file": "bkt-jira-triggers/openspec/specs/forge-trigger-flow-demo/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unanticipated fields in real p