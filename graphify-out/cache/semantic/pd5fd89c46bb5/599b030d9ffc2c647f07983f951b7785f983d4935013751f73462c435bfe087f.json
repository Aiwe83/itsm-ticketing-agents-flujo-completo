{"nodes": [{"id": "bkt_jira_triggers_openspec_changes_archive_2026_08_18_demonstrate_forge_trigger_flow_tasks", "label": "Tasks: demonstrate-forge-trigger-flow (archived 2026-08-18)", "file_type": "document", "source_file": "bkt-jira-triggers/openspec/changes/archive/2026-08-18-demonstrate-forge-trigger-flow/tasks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_jira_triggers_openspec_changes_archive_2026_08_18_demonstrate_forge_trigger_flow_tasks_retrospective_documentation", "label": "Change documented after implementation (inverse order)", "file_type": "rationale", "source_file": "bkt-jira-triggers/openspec/changes/archive/2026-08-18-demonstrate-forge-trigger-flow/tasks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Work was implemented and verified before the specification was written, the inverse of the usual order; the file states this plainly instead of hiding it."}, {"id": "bkt_jira_triggers_openspec_changes_archive_2026_08_18_demonstrate_forge_trigger_flow_tasks_git_baseline_and_local_excludes", "label": "Git baseline commit and local exclusion via .git/info/exclude", "file_type": "rationale", "source_file": "bkt-jira-triggers/openspec/changes/archive/2026-08-18-demonstrate-forge-trigger-flow/tasks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Project was not a repo, so a baseline was committed before touching anything; internal working files are excluded through .git/info/exclude rather than .gitignore so they stay on disk and out of history."}, {"id": "bkt_jira_triggers_openspec_changes_archive_2026_08_18_demonstrate_forge_trigger_flow_tasks_forgeignore_packaging", "label": "Deployment packaging with .forgeignore", "file_type": "concept", "source_file": "bkt-jira-triggers/openspec/changes/archive/2026-08-18-demonstrate-forge-trigger-flow/tasks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Excluding src/__tests__/ also avoids the packaging step requiring @types/jest, a dev dependency."}, {"id": "bkt_jira_triggers_openspec_changes_archive_2026_08_18_demonstrate_forge_trigger_flow_tasks_forge_real_deployment", "label": "Real Forge deployment (non-interactive auth, developer space, register, lint, deploy, install)", "file_type": "concept", "source_file": "bkt-jira-triggers/openspec/changes/archive/2026-08-18-demonstrate-forge-trigger-flow/tasks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Interactive login needs a real TTY so it fails in integrated terminals; forge register requires a Developer Space id without saying so; manifest.yml is committed immediately after register so the generated app.id cannot be lost."}, {"id": "bkt_jira_triggers_openspec_changes_archive_2026_08_18_demonstrate_forge_trigger_flow_tasks_demo_scenarios", "label": "Offline demo scenarios (created, updated, pii, invalid, errors, wire, plus listen/send)", "file_type": "concept", "source_file": "bkt-jira-triggers/openspec/changes/archive/2026-08-18-demonstrate-forge-trigger-flow/tasks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pii exits non-zero if a planted marker reaches the trace; wire sends a real HTTP request to an ephemeral local receiver; listen never terminates so listen/send are dispatched outside the all registry."}, {"id": "bkt_jira_triggers_openspec_changes_archive_2026_08_18_demonstrate_forge_trigger_flow_tasks_project_scoping_verification", "label": "Project scoping: deploy unfiltered, inspect event, then add filter.expression with onError RECEIVE_AND_LOG", "file_type": "rationale", "source_file": "bkt-jira-triggers/openspec/changes/archive/2026-08-18-demonstrate-forge-trigger-flow/tasks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "project must first be seen in issueFieldKeys of a real event; the negative half (other project produces zero trace lines) is verified first; both halves are required because either alone is inconclusive."}, {"id": "bkt_jira_triggers_openspec_changes_archive_2026_08_18_demonstrate_forge_trigger_flow_tasks_e2e_flow_with_public_https_receiver", "label": "E2E flow via public HTTPS receiver (remotes, fetch permission, admin re-consent, encrypted API key variable)", "file_type": "concept", "source_file": "bkt-jira-triggers/openspec/changes/archive/2026-08-18-demonstrate-forge-trigger-flow/tasks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_jira_triggers_openspec_changes_archive_2026_08_18_demonstrate_forge_trigger_flow_tasks_failure_path_expectation_correction", "label": "Failure path classified HTTP_503 rather than NETWORK/FETCH_FAILED", "file_type": "concept", "source_file": "bkt-jira-triggers/openspec/changes/archive/2026-08-18-demonstrate-forge-trigger-flow/tasks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The documented expectation was corrected because the destination domain still resolved, so the failure is an HTTP status, not a network failure."}, {"id": "bkt_jira_triggers_openspec_changes_archive_2026_08_18_demonstrate_forge_trigger_flow_tasks_data_protection_verified_on_real_events", "label": "Data protection verified on real events (title redacted, actor hashed, changelog names only, ten planted markers)", "file_type": "concept", "source_file": "bkt-jira-triggers/openspec/changes/archive/2026-08-18-demonstrate-forge-trigger-flow/tasks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Jira does not deliver description, attachments or custom fields to a trigger, so there are two barriers rather than one."}, {"id": "bkt_jira_triggers_openspec_changes_archive_2026_08_18_demonstrate_forge_trigger_flow_tasks_evidence_and_manual_test_guide", "label": "Evidence files under docs/evidence and manual test guide", "file_type": "concept", "source_file": "bkt-jira-triggers/openspec/changes/archive/2026-08-18-demonstrate-forge-trigger-flow/tasks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Guide is ordered by narrative so the test proving the point comes first; every expected output is a captured value; irreversible or token-exposing commands (register, login) are marked never to run live."}, {"id": "bkt_jira_triggers_openspec_changes_archive_2026_08_18_demonstrate_forge_trigger_flow_tasks_verification_gates", "label": "Verification gates (build, typecheck, lint, 28 tests in 4 suites, demo all, forge lint, empty src diff)", "file_type": "concept", "source_file": "bkt-jira-triggers/openspec/changes/archive/2026-08-18-demonstrate-forge-trigger-flow/tasks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "bkt_jira_triggers_openspec_changes_archive_2026_08_18_demonstrate_forge_trigger_flow_tasks", "target": "bkt_jira_triggers_openspec_changes_archive_2026_08_18_demonstrate_forge_trigger_flow_specs_forge_trigger_flow_demo_spec", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "bkt-jira-triggers/openspec/changes/archive/2026-08-18-demonstrate-forge-trigger-flow/tasks.md", "source_location": null, "weight": 1.0}, {"source": "bkt_jira_triggers_openspec_changes_archive_2026_08_18_demonstrate_forge_trigger_flow_tasks", "target": "bkt_jira_triggers_openspec_specs_forge_trigger_flow_demo_spec_change_demonstrate_forge_trigger_flow", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, 