dictionary_entry_format", "label": "Dictionary entry format (formField, jiraFieldId, readPath, targetField, decision, evidence, notes)", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-31-resolver-customfields-jira-datos-basicos/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_31_resolver_customfields_jira_datos_basicos_design_decision_states", "label": "Decision states (confirmed, pending-validation, excluded)", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-31-resolver-customfields-jira-datos-basicos/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_31_resolver_customfields_jira_datos_basicos_design_mandatory_27_field_inventory", "label": "Mandatory inventory of 27 basic-data fields", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-31-resolver-customfields-jira-datos-basicos/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Initial expected state: three confirmed by direct mapping (Tipo de incidencia, Referencia, Descripcion), one excluded (Adjuntos) and 23 pending-validation; later evidence may change states without altering the inventory."}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_31_resolver_customfields_jira_datos_basicos_design_confirmation_criteria", "label": "Four conditions to confirm a field", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-31-resolver-customfields-jira-datos-basicos/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "ra