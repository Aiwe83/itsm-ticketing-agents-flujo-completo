{"nodes": [{"id": "bkt_integration_service_openspec_specs_openapi_schema_hardening_spec", "label": "Spec: openapi-schema-hardening", "file_type": "document", "source_file": "bkt-integration-service/openspec/specs/openapi-schema-hardening/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Defines how strictly generated OpenAPI component schemas constrain payload shape: closed self-owned response schemas, open mapping-driven schemas, and length/pattern/range/array bounds."}, {"id": "bkt_integration_service_openspec_specs_openapi_schema_hardening_spec_own_response_schemas_reject_unknown_properties", "label": "Requirement: own response schemas reject unknown properties", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/specs/openapi-schema-hardening/spec.md", "source_location": "L9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "additionalProperties:false on schemas whose whole property set is controlled by this service (ExecutionError, AttachedDocument, IssueInfo, IssueProcess*, IssueAcceptedResponse, ErrorResponse, RateLimitErrorResponse, HealthResponse, ApiRootResponse)."}, {"id": "bkt_integration_service_openspec_specs_openapi_schema_hardening_spec_mapping_driven_schemas_remain_open", "label": "Requirement: mapping-driven and echoed schemas remain open", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/specs/openapi-schema-hardening/spec.md", "source_location": "L16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "IssueContent, technicianInfo, IssuePayload, IssueBatchRequest and their nested fields/issuetype stay open because their real contract is driven by external Jira data and MongoDB mappings; additionalProperties references JsonValue rather than an empty schema."}, {"id": "bkt_integration_service_openspec_specs_openapi_schema_hardening_spec_doc_string_fields_length_and_pattern", "label": "Requirement: documentation string fields declare maxLength and control-character-safe pattern", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/specs/openapi-schema-hardening/spec.md", "source_location": "L31", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_specs_openapi_schema_hardening_spec_runtime_validator_string_bounds", "label": "Requirement: runtime validator string fields declare length ceiling and pattern", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/specs/openapi-schema-hardening/spec.md", "source_location": "L42", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Five z.string() fields in src/validators/issue.validator.ts (issuePayload.id, issuePayload.key, fields.summary, fields.issuetype.name, issueBatch.initiatedBy) get a generous maxLength and the same freeText pattern used for documentation-only fields."}, {"id": "bkt_integration_service_openspec_specs_openapi_schema_hardening_spec_error_status_code_range", "label": "Requirement: ErrorResponse.error.statusCode constrained to 100..599", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/specs/openapi-schema-hardening/spec.md", "source_location": "L57", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_specs_openapi_schema_hardening_spec_response_array_size_bounds", "label": "Requirement: response arrays declare size bounds matching business rules", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/specs/openapi-schema-hardening/spec.md", "source_location": "L68", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "IssueProcessResult.errors max 50, IssueProcessResponse.tickets exactly 1 (mirrors the one-ticket-per-request rule), attachedDocuments max 100, actions max 200."}, {"id": "bkt_integration_service_openspec_specs_openapi_schema_hardening_spec_open_additional_properties_typed_json_value", "label": "Requirement: open additionalProperties use a typed finite JsonValue", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/specs/openapi-schema-hardening/spec.md", "source_location": "L79", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_specs_openapi_schema_hardening_spec_jsonvalue_schema", "label": "JsonValue component schema (finite, non-recursive)", "file_type": "concept", "source_file": "bkt-integration-service/openspec/specs/openapi-schema-hardening/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "anyOf JsonPrimitive (string, number, boolean), array of JsonPrimitive, or object of JsonPrimitive values; must never reference itself directly or indirectly; a null leaf value must validate."}, {"id": "bkt_integration_service_openspec_specs_openapi_schema_hardening_spec_freetext_control_char_pattern", "label": "freeText pattern (rejects control characters, accepts other Unicode)", "file_type": "concept", "source_file": "bkt-integration-service/openspec/specs/openapi-schema-hardening/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_specs_openapi_schema_hardening_spec_error_details_open_schema", "label": "ErrorResponse.error.details stays an empty schema (by design)", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/specs/openapi-schema-hardening/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Its real shape is polymorphic and nests deeper than the bounded depth of JsonValue, so it is out of scope for the typed JsonValue requirement."}, {"id": "bkt_integration_service_openspec_specs_openapi_schema_hardening_spec_issue_content_schema", "label": "IssueContent schema", "file_type": "concept", "source_file": "bkt-integration-service/openspec/specs/openapi-schema-hardening/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_specs_openapi_schema_hardening_spec_issue_payload_schema", "label": "IssuePayload schema", "file_type": "concept", "source_file": "bkt-integration-service/openspec/specs/openapi-schema-hardening/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_specs_openapi_schema_hardening_spec_issue_batch_request_schema", "label": "IssueBatchRequest schema", "file_type": "concept", "source_file": "bkt-integration-service/openspec/specs/openapi-schema-hardening/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_specs_openapi_schema_hardening_spec_issue_process_response_schema", "label": "IssueProcessResponse schema", "file_type": "concept", "source_file": "bkt-integration-service/openspec/specs/openapi-schema-hardening/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "bkt_integration_service_openspec_specs_openapi_schema_hardening_spec", "target": "bkt_integration_service_openspec_specs_openapi_schema_hardening_spec_own_response_schemas_reject_unknown_properties", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "bkt-integration-service/openspec/specs/openapi-schema-hardening/spec.md", "source_location": null, "weight": 1.0}, {"source": "bkt_integration_service_openspec_specs_openapi_schema_hardening_spec", "target": "bkt_integration_service_open