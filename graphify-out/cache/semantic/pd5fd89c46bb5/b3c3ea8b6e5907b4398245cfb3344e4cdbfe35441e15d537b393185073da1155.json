{"nodes": [{"id": "bkt_jira_triggers_openspec_changes_archive_2026_08_31_forge_integration_service_design", "label": "Design: Forge to integration-service (TICK-17)", "file_type": "document", "source_file": "bkt-jira-triggers/openspec/changes/archive/2026-08-31-forge-integration-service/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_jira_triggers_openspec_changes_archive_2026_08_31_forge_integration_service_design_tick_17", "label": "TICK-17 (real Jira to Forge to integration-service E2E request)", "file_type": "concept", "source_file": "bkt-jira-triggers/openspec/changes/archive/2026-08-31-forge-integration-service/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_jira_triggers_openspec_changes_archive_2026_08_31_forge_integration_service_design_decision_keep_repos_separate", "label": "Decision 1: keep triggers and integration-service repositories separate", "file_type": "rationale", "source_file": "bkt-jira-triggers/openspec/changes/archive/2026-08-31-forge-integration-service/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Different lifecycles and deployment models; the HTTP contract is the correct system boundary; repository fusion adds risk and does not help prove the requested flow. integration-service is only started, exposed, called and observed."}, {"id": "bkt_jira_triggers_openspec_changes_archive_2026_08_31_forge_integration_service_design_decision_direct_https_post", "label": "Decision 2: direct HTTPS POST for the demo", "file_type": "rationale", "source_file": "bkt-jira-triggers/openspec/changes/archive/2026-08-31-forge-integration-service/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Demo must be short, visible and easy to explain; a queue or proxy is unnecessary for TICK-17; the service already exposes the right endpoint."}, {"id": "bkt_jira_triggers_openspec_changes_archive_2026_08_31_forge_integration_service_design_decision_public_https_reachability_gate", "label": "Decision 3: public HTTPS reachability as a gate", "file_type": "rationale", "source_file": "bkt-jira-triggers/openspec/changes/archive/2026-08-31-forge-integration-service/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Forge cannot call localhost; preferred order is approved dev/staging URL, corporate gateway or DMZ route, then temporary HTTPS tunnel. The tool is not the requirement, reachability is."}, {"id": "bkt_jira_triggers_openspec_changes_archive_2026_08_31_forge_integration_service_design_https_tunnel_options", "label": "Temporary HTTPS tunnel options (Cloudflare Tunnel, ngrok)", "file_type": "concept", "source_file": "bkt-jira-triggers/openspec/changes/archive/2026-08-31-forge-integration-service/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_jira_triggers_openspec_changes_archive_2026_08_31_forge_integration_service_design_decision_secrets_out_of_files_and_logs", "label": "Decision 4: secrets kept out of files and logs (Forge variables)", "file_type": "rationale", "source_file": "bkt-jira-triggers/openspec/changes/archive/2026-08-31-forge-integration-service/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Service URL and API key are configured through Forge variables; key material must never appear in code, docs, commits, logs or evidence."}, {"id": "bkt_jira_triggers_openspec_changes_archive_2026_08_31_forge_integration_service_design_decision_preserve_response_truth", "label": "Decision 5: preserve response truth (201 plus successIntegration plus tickets[0].success)", "file_type": "rationale", "source_file": "bkt-jira-triggers/openspec/changes/archive/2026-08-31-forge-integration-service/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A 201 is only transport acceptance; application success must be read from data.summary.successIntegration and data.tickets[0].success, with storedTicketId when available."}, {"id": "bkt_jira_triggers_openspec_changes_archive_2026_08_31_forge_integration_service_design_outbound_request_interface", "label": "Outbound request interface (POST /api/v1/issues with Content-Type, X-Request-Id, X-API-KEY; one issue per request)", "file_type": "concept", "source_file": "bkt-jira-triggers/openspec/changes/archive/2026-08-31-forge-integration-service/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_jira_triggers_openspec_changes_archive_2026_08_31_forge_integration_service_design_forge_variables", "label": "Forge variables (INTEGRATION_SERVICE_BASE_URL, INTEGRATION_SERVICE_API_KEY, INTEGRATION_SERVICE_API_KEY_HEADER)", "file_type": "concept", "source_file": "bkt-jira-triggers/openspec/changes/archive/2026-08-31-forge-integration-service/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_jira_triggers_openspec_changes_archive_2026_08_31_forge_integration_service_design_manifest_egress", "label": "Manifest egress (temporary remotes plus permissions.external.fetch.backend for one HTTPS destination)", "file_type": "concept", "source_file": "bkt-jira-triggers/openspec/changes/archive/2026-08-31-forge-integration-service/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Egress is declared only during an active demo; outside it the repository returns to the at-rest state with no egress."}, {"id": "bkt_jira_triggers_openspec_changes_archive_2026_08_31_forge_integration_service_design_flow_sequence", "label": "Flow: Jira event, handler correlationId, sanitise, buildIssuesRequest, POST, service validation, sanitised response log, evidence", "file_type": "concept", "source_file": "bkt-jira-triggers/openspec/changes/archive/2026-08-31-forge-integration-service/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_jira_triggers_openspec_changes_archive_2026_08_31_forge_integration_service_design_failure_handling", "label": "Failure handling (fail closed on missing config or invalid payload; classified network/timeout/HTTP/parse failures)", "file_type": "rationale", "source_file": "bkt-jira-triggers/openspec/changes/archive/2026-08-31-forge-integration-service/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A 201 with a failed application body is recorded as application failure, not success; the handler never crashes."}, {"id": "bkt_jira_triggers_openspec_changes_archive_2026_08_31_forge_integration_service_design_security_and_evidence_rules", "label": "Security and evidence rules (no keys, emails, names, description, raw title, attachments, sensitive URLs)", "file_type": "concept", "source_file": "bkt-jira-triggers/openspec/changes/archive/2026-08-31-forge-integration-service/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_jira_triggers_openspec_changes_archive_2026_08_31_forge_integration_service_design_rollback_procedure", "label": "Rollback to at-rest state (git checkout manifest.yml, forge variables unset, redeploy, verify)", "file_type": "concept", "source_file": "bkt-jira-triggers/openspec/changes/archive/2026-08-31-forge-integration-service/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": 