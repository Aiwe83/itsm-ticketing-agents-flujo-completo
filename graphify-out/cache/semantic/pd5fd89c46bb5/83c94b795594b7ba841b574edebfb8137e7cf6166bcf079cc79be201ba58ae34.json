{"nodes": [{"id": "bkt_integration_service_openspec_changes_archive_2026_08_12_cerrar_hallazgos_42crunch_ronda_2_design", "label": "design: cerrar-hallazgos-42crunch-ronda-2", "file_type": "document", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-12-cerrar-hallazgos-42crunch-ronda-2/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_12_cerrar_hallazgos_42crunch_ronda_2_design_round1_open_decisions", "label": "Round 1 open decisions revoked in round 2", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-12-cerrar-hallazgos-42crunch-ronda-2/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Round 1 design left three decisions open (no pattern in runtime validator, no real auth, http accepted in servers.protocol); round 2 revokes all three after consulting the user on each."}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_12_cerrar_hallazgos_42crunch_ronda_2_design_openapi_generation_pipeline", "label": "openapi.yaml generated from src/openapi via z.registry and z.toJSONSchema", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-12-cerrar-hallazgos-42crunch-ronda-2/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_12_cerrar_hallazgos_42crunch_ronda_2_design_issuepayload_reuses_runtime_validator", "label": "IssuePayload and IssueBatchRequest reuse issue.validator.ts schemas", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-12-cerrar-hallazgos-42crunch-ronda-2/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "These two schemas are imported from the runtime validator, the only validator running on real Jira/TC payloads at POST /api/v1/issues; everything else in schemas.ts is documentation-only."}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_12_cerrar_hallazgos_42crunch_ronda_2_design_apikey_middleware", "label": "apiKeyMiddleware (auth.middleware.ts)", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-12-cerrar-hallazgos-42crunch-ronda-2/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_12_cerrar_hallazgos_42crunch_ronda_2_design_middleware_mounted_in_router", "label": "Mount auth middleware in routes/index.ts router", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-12-cerrar-hallazgos-42crunch-ronda-2/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mounting on router.use('/api/{API_VERSION}') keeps auth logic in one file and already runs under requestIdMiddleware so the 401 carries requestId; rejected alternative was a global app.ts middleware with a path.startsWith check."}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_12_cerrar_hallazgos_42crunch_ronda_2_design_constant_time_key_comparison", "label": "Constant-time key comparison (SHA-256 digests plus timingSafeEqual)", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-12-cerrar-hallazgos-42crunch-ronda-2/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plain === leaks the matching prefix through timing; hashing both sides first always yields two 32-byte buffers so timingSafeEqual never throws on length mismatch and no special branch is needed."}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_12_cerrar_hallazgos_42crunch_ronda_2_design_single_unauthorized_message", "label": "Single error message for missing and incorrect API key", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-12-cerrar-hallazgos-42crunch-ronda-2/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AppError.unauthorized('Missing or invalid API key') avoids confirming to an attacker that the auth mechanism exists or which failure mode is being probed."}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_12_cerrar_hallazgos_42crunch_ronda_2_design_health_public_by_design", "label": "GET /health stays public by design", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-12-cerrar-hallazgos-42crunch-ronda-2/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "It is the liveness/readiness probe of docker-compose and Kubernetes; requiring auth would break operational healthchecks; accepted cost is about 7 High points left open in 42Crunch."}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_12_cerrar_hallazgos_42crunch_ronda_2_design_single_shared_secret_scope", "label": "Single shared secret API_KEY (no rotation, multiple keys or scopes)", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-12-cerrar-hallazgos-42crunch-ronda-2/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Minimal scope sufficient for the 42Crunch finding and consistent with endurecer-ingesta-jira-piloto task 2.1."}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_12_cerrar_hallazgos_42crunch_ronda_2_design_freetext_pattern", "label": "freeText control-character-blocking pattern (C0 plus DEL)", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-12-cerrar-hallazgos-42crunch-ronda-2/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_12_cerrar_hallazgos_42crunch_ronda_2_design_permissive_pattern_runtime_validator", "label": "Permissive freeText pattern in the runtime validator (revokes round 1 D3)", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-12-cerrar-hallazgos-42crunch-ronda-2/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Regex already in production on 12+ documentation fields without incident and the real postman-collection.json fixture is the end-to-end safety net; propagation by $ref into IssueProcessResult.issue closes 4 response findings at once; rejected alternative was injecting the pattern only in the YAML, which would be a false contract."}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_12_cerrar_hallazgos_42crunch_ronda_2_design_jsonvalue_schema", "label": "JsonValue typed open-schema post-process", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-12-cerrar-hallazgos-42crunch-ronda-2/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "additionalProperties {} is replaced by a $ref to JsonValue in a post-process of componentSchemas rather than Zod .catchall(), which would change runtime behavior and could reject deeply nested Atlassian Document Format data; anyOf instead of oneOf because OAS 3.0 has no type null."}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_12_cerrar_hallazgos_42crunch_ronda_2_design_jsonvalue_finite_two_level", "label": "JsonValue finite two-level design (JsonPrimitive plus JsonValue)", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-12-cerrar-hallazgos-42crunch-ronda-2/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A self-referencing JsonValue triggered Circular reference (Critical) x7 in 42Crunch; split into a JsonPrimitive leaf and a finite JsonValue anyOf of primitive, array of primitive, object of primitive."}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_12_cerrar_hallazgos_42crunch_ronda_2_design_circular_reference_incident", "label": "Circular reference incident (42Crunch Critical x7, global score 0/100)", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-12-cerrar-hallazgos-42crunch-ronda-2/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_12_cerrar_hallazgos_42crunch_ronda_2_design_error_details_excluded_from_jsonvalue", "label": "error.details excluded from JsonValue substitution", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-12-cerrar-hallazgos-42crunch-ronda-2/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ErrorResponse.error.details is polymorphic and nests deeper than bounded JsonValue; typing it broke openapi:lint with 20 warnings, so it stays {} (round 1 Non-Goal still applies)."}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_12_cerrar_hallazgos_42crunch_ronda_2_design_collapse_single_allof", "label": "Collapse single-branch allOf to direct $ref", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-12-cerrar-hallazgos-42crunch-ronda-2/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "IssueProcessResult.transformedIssue was the only allOf in the document, produced by z.toJSONSchema openapi-3.0 wrapping optional registered schemas; 42Crunch penalizes allOf combined with additionalProperties false."}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_12_cerrar_hallazgos_42crunch_ronda_2_design_protocol_https_only", "label": "servers protocol enum drops http (revokes round 1 D5)", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-12-cerrar-hallazgos-42crunch-ronda-2/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The published spec should not advertise HTTP as a supported option; local HTTP usage is documented in README instead of the contract."}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_12_cerrar_hallazgos_42crunch_ronda_2_design_measured_result_round2", "label": "Measured result: 42Crunch global 0 to 75/100", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-12-cerrar-hallazgos-42crunch-ronda-2/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_12_cerrar_hallazgos_42crunch_ronda_2_design_residual_findings_tradeoffs", "label": "Remaining 42Crunch findings are deliberate trade-offs", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-12-cerrar-hallazgos-42crunch-ronda-2/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_12_cerrar_hallazgos_42crunch_ronda_2_design_open_question_trust_proxy_hops", "label": "Open question: TRUST_PROXY_HOPS in a later change", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-12-cerrar-hallazgos-42crunch-ronda-2/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_12_cerrar_hallazgos_42crunch_ronda_2_design_breaking_rollout_plan", "label": "Migration plan: deploy with API_KEY present, notify consumers, regenerate, rollback by unmounting middleware", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-12-cerrar-hallazgos-42crunch-ronda-2/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "bkt_integration_service_openspec_changes_archive_2026_08_12_cerrar_hallazgos_42crunch_ronda_2_design", "target": "bkt_integration_service_openspec_changes_archive_2026_08_12_cerrar_hallazgos_42crunch_ronda_2_proposal_change_cerrar_hallazgos_42crunch_ronda_2", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-12-cerrar-hallazgos-42crunch-ronda-2/design.md", "source_location": null, "weight": 1.0}, {"source": "bkt_integration_service_openspec_changes_archive_2026_08_12_cerrar_hallazgos_42crunch_ronda_2_design", "target": "bkt_integration_service_openspec_changes_archive_2026_08_12_cerrar_hallazgos_42crunch_ronda_2_design_round1_open_decisions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-12-cerrar-hallazgos-42crunch-ronda-2/design.md", "source_location": null, "weight": 1.0}, {"source": "bkt_integration_service_openspec_changes_archive_2026_08_12_cerrar_hallazgos_42crunch_ronda_2_design", "target": "