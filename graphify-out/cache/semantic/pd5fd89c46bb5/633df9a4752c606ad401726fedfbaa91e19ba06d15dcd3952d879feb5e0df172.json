{"nodes": [{"id": "bkt_integration_service_openspec_changes_operacionalizar_catalogo_mappings_design", "label": "Design: operacionalizar-catalogo-mappings", "file_type": "document", "source_file": "bkt-integration-service/openspec/changes/operacionalizar-catalogo-mappings/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_changes_operacionalizar_catalogo_mappings_design_mapping_model_random_uuid", "label": "Mapping model (random UUID ids, copy default transformer)", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/operacionalizar-catalogo-mappings/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Current state: the Mapping model assigns random UUIDs and the transformer defaults to copy; both motivate deterministic identity and a closed transformer list."}, {"id": "bkt_integration_service_openspec_changes_operacionalizar_catalogo_mappings_design_catalog_version_and_canonical_key", "label": "Catalog version and canonical mapping key (meshId+sourceField+targetField)", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/operacionalizar-catalogo-mappings/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deterministic identity (map:<sha256 of meshId, sourceField, targetField> when catalog has no _id) is chosen over random UUIDs so applying the same catalog twice updates the same MongoDB document. Existing UUIDs are not migrated automatically."}, {"id": "bkt_integration_service_openspec_changes_operacionalizar_catalogo_mappings_design_apply_upsert_preserving_id", "label": "Apply upsert algorithm preserving existing _id", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/operacionalizar-catalogo-mappings/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Existing document is looked up by logical key (never by computed _id); if found, updateOne by its original _id with $set of the projection; otherwise insert with _id map:<sha256>. Avoids duplicating mappings loaded by hand with random UUIDs."}, {"id": "bkt_integration_service_openspec_changes_operacionalizar_catalogo_mappings_design_mappings_dry_run_default_mode", "label": "mappings:dry-run default non-writing mode", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/operacionalizar-catalogo-mappings/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compare first, write only with explicit consent. Validates JSON and context and reports added, updated, unchanged, conflicts and mongoOnly without printing sensitive values or Jira payloads."}, {"id": "bkt_integration_service_openspec_changes_operacionalizar_catalogo_mappings_design_mappings_apply_confirm_version", "label": "mappings:apply with --confirm-version guard", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/operacionalizar-catalogo-mappings/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ends without writing if the confirmed version differs from catalogVersion, the context does not match the environment, or conflicts exist."}, {"id": "bkt_integration_service_openspec_changes_operacionalizar_catalogo_mappings_design_clean_projection_to_mongodb", "label": "Clean projection of catalog entries to MongoDB", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/operacionalizar-catalogo-mappings/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Whitelist of _id, meshId, sourceField, targetField, transformer, required, description, options, createdBy, updatedBy. Properties prefixed with _ (such as _evidence), pending candidates, excluded fields and coverage sections stay out of MongoDB."}, {"id": "bkt_integration_service_openspec_changes_operacionalizar_catalogo_mappings_design_closed_transformer_allowlist", "label": "Closed transformer allowlist (copy, mapToString, severity)", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/operacionalizar-catalogo-mappings/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An unknown transformer must break both a successful dry-run and ticket processing; silently degrading to copy could produce incorrect tickets without any clear signal."}, {"id": "bkt_integration_service_openspec_changes_operacionalizar_catalogo_mappings_design_catalog_integrity_rules", "label": "Catalog integrity validation rules", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/operacionalizar-catalogo-mappings/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rejects content.statusSp, sourceField equal to fields or whole-section targets, two confirmed mappings for the same targetField in a context, entries missing mandatory fields, and evidence or pending candidates inside the loadable list."}, {"id": "bkt_integration_service_openspec_changes_operacionalizar_catalogo_mappings_design_mapping_version_traceability", "label": "Traceability by mappingVersion in ticket and execution", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/operacionalizar-catalogo-mappings/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Translated ticket and execution models gain an optional mappingVersion (historical compatibility). Service takes one coherent snapshot of active mappings per ticket; version is derived from the applied catalog, not the process date."}, {"id": "bkt_integration_service_openspec_changes_operacionalizar_catalogo_mappings_design_mongo_only_no_auto_delete", "label": "mongoOnly entries reported but never auto-deleted", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/operacionalizar-catalogo-mappings/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deleting obsolete mappings is a non-goal and needs another approved decision; rollback is restoring and explicitly applying the previous catalog version."}], "edges": [{"source": "bkt_integration_service_openspec_changes_operacionalizar_catalogo_mappings_design", "target": "bkt_integration_service_openspec_changes_operacionalizar_catalogo_mappings_design_mapping_model_random_uuid", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "bkt-integration-service/openspec/changes/operacionalizar-catalogo-mappings/design.md", "source_location": null, "weight": 1.0}, {"source": "bkt_integration_service_openspec_changes_operacionalizar_catalogo_mappings_design", "target": "bkt_integration_service_openspec_changes_operacionalizar_catalogo_mappings_design_catalog_version_and_canonical_key", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "bkt-integration-service/openspec/changes/operacionalizar-catalogo-mappings/design.md", "source_location": null, "weight": 1.0}, {"source": "bkt_integration_service_openspec_changes_operacionalizar_catalogo_mappings_design", "target": "bkt_integration_service_openspec_changes_operacionalizar_catalogo_mappings_design_apply_upsert_preserving_id", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "bkt-integration-service/openspec/changes/operacionalizar-catalogo-map