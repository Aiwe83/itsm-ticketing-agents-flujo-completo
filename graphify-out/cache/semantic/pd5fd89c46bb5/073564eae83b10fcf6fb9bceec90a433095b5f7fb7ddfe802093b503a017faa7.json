{"nodes": [{"id": "bkt_integration_service_openspec_specs_jira_ticket_attachments_spec", "label": "Spec: jira-ticket-attachments (Jira ingestion with attachments)", "file_type": "document", "source_file": "bkt-integration-service/openspec/specs/jira-ticket-attachments/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Defines Jira ingestion with attachments: raw persistence, controlled enrichment and traceability without blocking the HTTP response."}, {"id": "bkt_integration_service_openspec_specs_jira_ticket_attachments_spec_single_ticket_per_request", "label": "Requirement: accept exactly one Jira ticket per request", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/specs/jira-ticket-attachments/spec.md", "source_location": "L6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "POST /api/v1/issues is the only ingestion endpoint; zero or more than one ticket is a validation error; unsupported parallel ingestion routes return 404 and create no raw, translated or execution document."}, {"id": "bkt_integration_service_openspec_specs_jira_ticket_attachments_spec_persist_raw_before_translation", "label": "Requirement: persist raw Jira ticket before translation", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/specs/jira-ticket-attachments/spec.md", "source_location": "L25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The raw ticket is stored in itsm_tickets before mappings are applied so the request can be audited later; attachment processing must never modify the raw content."}, {"id": "bkt_integration_service_openspec_specs_jira_ticket_attachments_spec_translate_with_mappings", "label": "Requirement: translate Jira fields using mappings", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/specs/jira-ticket-attachments/spec.md", "source_location": "L35", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Translation uses MongoDB mappings and stores the result in tickets with Jira-aligned field names (status instead of statusSp); an unsupported attachment must not fail the ticket."}, {"id": "bkt_integration_service_openspec_specs_jira_ticket_attachments_spec_safe_remote_attachment_download", "label": "Requirement: download remote Jira attachments safely", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/specs/jira-ticket-attachments/spec.md", "source_location": "L50", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only the configured Jira origin is allowed, redirects are not followed, a maximum response size applies, credentials come only from environment variables and authorization/password data is redacted from logs."}, {"id": "bkt_integration_service_openspec_specs_jira_ticket_attachments_spec_notify_orchestrator_after_enrichment", "label": "Requirement: notify orchestrator after persistence and enrichment", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/specs/jira-ticket-attachments/spec.md", "source_location": "L71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The orchestrator must see the already enriched translated ticket, but the HTTP response never waits for it; attachment and orchestrator errors are recorded in executions."}, {"id": "bkt_integration_service_openspec_specs_jira_ticket_attachments_spec_attached_documents", "label": "content.attachedDocuments (attachment filename + plain text)", "file_type": "concept", "source_file": "bkt-integration-service/openspec/specs/jira-ticket-attachments/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_specs_jira_ticket_attachments_spec_skipped_attachment_result", "label": "Skipped attachment result (unsupported, foreign origin or too large)", "file_type": "concept", "source_file": "bkt-integration-service/openspec/specs/jira-ticket-attachments/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_specs_jira_ticket_attachments_spec_jira_base_url_env", "label": "JIRA_BASE_URL (allowed attachment origin, env variable name)", "file_type": "concept", "source_file": "bkt-integration-service/openspec/specs/jira-ticket-attachments/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "bkt_integration_service_openspec_specs_jira_ticket_attachments_spec", "target": "bkt_integration_service_openspec_specs_jira_ticket_attachments_spec_single_ticket_per_request", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "bkt-integration-service/openspec/specs/jira-ticket-attachments/spec.md", "source_location": null, "weight": 1.0}, {"source": "bkt_integration_service_openspec_specs_jira_ticket_attachments_spec", "target": "bkt_integration_service_openspec_specs_jira_ticket_attachments_spec_persist_raw_before_translation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "bkt-integration-service/openspec/specs/jira-ticket-attachments/spec.md", "source_location": null, "weight": 1.0}, {"source": "bkt_integration_service_openspec_specs_jira_ticket_attachments_spec", "target": "bkt_integration_service_openspec_specs_jira_ticket_attachments_spec_translate_with_mappings", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "bkt-integration-service/openspec/specs/jira-ticket-attachments/spec.md", "source_location": null, "weight": 1.0}, {"source": "bkt_integration_service_openspec_specs_jira_ticket_attachments_spec", "target": "bkt_int