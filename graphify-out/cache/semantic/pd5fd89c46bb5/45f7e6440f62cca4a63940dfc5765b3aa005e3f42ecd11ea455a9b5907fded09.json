{"nodes": [{"id": "bkt_integration_service_openspec_changes_archive_2026_08_31_jira_attachment_processing_hardening_design", "label": "jira-attachment-processing-hardening: design.md", "file_type": "document", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-31-jira-attachment-processing-hardening/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_31_jira_attachment_processing_hardening_design_attachment_processing_service", "label": "Attachment Processing Service", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-31-jira-attachment-processing-hardening/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Neutral service that converts supported Jira attachments (inline text, remote URLs, text-like extensions, Word-compatible files) into plain text; unsupported attachments never fail the ticket and are returned with a skippedReason."}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_31_jira_attachment_processing_hardening_design_mammoth_word_conversion", "label": "Word-compatible conversion via mammoth (docx, dotx, odt)", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-31-jira-attachment-processing-hardening/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_31_jira_attachment_processing_hardening_design_skipped_reason", "label": "skippedReason (unsupported, too_large, download_failed)", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-31-jira-attachment-processing-hardening/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_31_jira_attachment_processing_hardening_design_secure_jira_attachment_fetcher", "label": "Secure Jira Attachment Fetcher", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-31-jira-attachment-processing-hardening/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Created only when JIRA_BASE_URL, JIRA_USER and JIRA_PASSWORD are configured; downloads remote attachments under strict origin, redirect, size and credential rules."}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_31_jira_attachment_processing_hardening_design_jira_origin_pinning", "label": "Jira origin pinning for attachment URLs", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-31-jira-attachment-processing-hardening/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Attachment URLs come from incoming payloads; only URLs whose origin matches JIRA_BASE_URL are accepted, mitigating the risk of a remote attachment URL targeting another host."}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_31_jira_attachment_processing_hardening_design_redirects_disabled", "label": "Redirects disabled for attachment downloads", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-31-jira-attachment-processing-hardening/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Together with origin validation, disabling redirects prevents a download from being bounced to another host."}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_31_jira_attachment_processing_hardening_design_attachment_bytes_limit", "label": "ATTACHMENT_BYTES_LIMIT response size limit", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-31-jira-attachment-processing-hardening/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Remote files could be too large; mitigated by a declared-size check and an HTTP response size limit, marking the attachment as too_large."}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_31_jira_attachment_processing_hardening_design_jira_credentials_from_environment", "label": "Jira credentials from environment variables only", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-31-jira-attachment-processing-hardening/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Credentials (JIRA_USER, JIRA_PASSWORD) and JIRA_BASE_URL come exclusively from environment variables, never from payloads or code."}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_31_jira_attachment_processing_hardening_design_pino_log_redaction", "label": "Pino log redaction (authorization, headers, passwords)", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-31-jira-attachment-processing-hardening/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Credentials could leak through HTTP client errors; logger redaction covers authorization, headers.authorization, request and HTTP client authorization headers and passwords."}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_31_jira_attachment_processing_hardening_design_content_attached_documents", "label": "content.attachedDocuments (translated ticket field)", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-31-jira-attachment-processing-hardening/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The translated ticket is the downstream contract for agents, so attachment plain text is stored there and not in a separate model or collection."}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_31_jira_attachment_processing_hardening_design_issue_service_enrichment_flow", "label": "IssueService orchestration flow with attachment enrichment", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-31-jira-attachment-processing-hardening/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Steps: store raw in itsm_tickets, translate, store translated in tickets, attempt attachment enrichment from fields.attachment or fields.attachments, upsert enriched ticket, notify orchestrator in background, record errors in executions."}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_31_jira_attachment_processing_hardening_design_attachment_failures_non_fatal", "label": "Attachment failures are traceability errors, not ingestion failures", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-31-jira-attachment-processing-hardening/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A successfully translated ticket must not become a failed ticket because an attachment failed; the error is recorded in executions."}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_31_jira_attachment_processing_hardening_design_single_ingestion_route", "label": "Single ingestion route (POST /api/v1/issues only)", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-31-jira-attachment-processing-hardening/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "routes/index.ts mounts only the supported Jira issue route; unsupported parallel ingestion routes return 404 and create no MongoDB documents."}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_31_jira_attachment_processing_hardening_design_background_orchestrator_notification_after_enrichment", "label": "Background orchestrator notification after enrichment", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-31-jira-attachment-processing-hardening/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_31_jira_attachment_processing_hardening_design_raw_payload_preserved_unchanged", "label": "Raw Jira payload preserved unchanged", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-31-jira-attachment-processing-hardening/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Attachment processing must not modify the raw ticket in itsm_tickets so the request stays auditable; enrichment is additive on the translated ticket."}], "edges": [{"source": "bkt_integration_service_openspec_changes_archive_2026_08_31_jira_attachment_processing_hardening_design", "target": "bkt_integration_service_openspec_changes_archive_2026_08_31_jira_attachment_processing_hardening_proposal_change", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-31-jira-attachment-processing-hardening/design.md", "source_location": null, "weight": 1}, {"source": "bkt_integration_service_openspec_changes_archive_2026_08_31_jira_attachment_processing_hardening