{"nodes": [{"id": "bkt_integration_service_docs_mappings_pruebas_manuales_puntos_integration_service_bkt", "label": "Demo manual: Los 7 puntos de Tarea_7 (INTEGRATION-SERVICE)", "file_type": "document", "source_file": "bkt-integration-service/docs/mappings/Pruebas_manuales_puntos_integration_service_bkt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_docs_mappings_pruebas_manuales_puntos_integration_service_bkt_punto_1_errors_without_stack", "label": "Punto 1 - Errors do not expose stack", "file_type": "rationale", "source_file": "bkt-integration-service/docs/mappings/Pruebas_manuales_puntos_integration_service_bkt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Avoids leaking internal technical detail to API consumers; the stack trace lives only in internal server logs, never in the HTTP response."}, {"id": "bkt_integration_service_docs_mappings_pruebas_manuales_puntos_integration_service_bkt_punto_2_split_1_1_shared_id_unique_index", "label": "Punto 2 - 1:1 split itsm_tickets/tickets with same _id, protected by unique index", "file_type": "rationale", "source_file": "bkt-integration-service/docs/mappings/Pruebas_manuales_puntos_integration_service_bkt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Guarantees 1:1 traceability between the received and the stored ticket and protects against duplicates when Jira retries or repeats webhooks."}, {"id": "bkt_integration_service_docs_mappings_pruebas_manuales_puntos_integration_service_bkt_punto_3_real_mongo_dates", "label": "Punto 3 - Real Mongo Date timestamps", "file_type": "rationale", "source_file": "bkt-integration-service/docs/mappings/Pruebas_manuales_puntos_integration_service_bkt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Allows correct sorting, filtering and comparison of dates without manual text parsing."}, {"id": "bkt_integration_service_docs_mappings_pruebas_manuales_puntos_integration_service_bkt_punto_4_meshid_context", "label": "Punto 4 - meshId in all new context documents", "file_type": "rationale", "source_file": "bkt-integration-service/docs/mappings/Pruebas_manuales_puntos_integration_service_bkt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Confirms the service works with the current context model and no longer depends on the deprecated tenantId/projectId/itsmId fields."}, {"id": "bkt_integration_service_docs_mappings_pruebas_manuales_puntos_integration_service_bkt_punto_5_active_database", "label": "Punto 5 - Active database is integration-service", "file_type": "rationale", "source_file": "bkt-integration-service/docs/mappings/Pruebas_manuales_puntos_integration_service_bkt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prevents silently writing to the wrong database (e.g. legacy caf_agents, which is only a read source for migrations)."}, {"id": "bkt_integration_service_docs_mappings_pruebas_manuales_puntos_integration_service_bkt_punto_6_orchestrator_dispatch_traceability", "label": "Punto 6 - Traceability of what was notified to the orchestrator", "file_type": "rationale", "source_file": "bkt-integration-service/docs/mappings/Pruebas_manuales_puntos_integration_service_bkt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Leaves an auditable record of which tickets were actually notified, useful to investigate later who learned about a ticket."}, {"id": "bkt_integration_service_docs_mappings_pruebas_manuales_puntos_integration_service_bkt_punto_7_english_camelcase_naming", "label": "Punto 7 - English camelCase naming", "f