{"nodes": [{"id": "bkt_integration_service_openspec_changes_reconciliar_baseline_y_openspec_design", "label": "Design: reconciliar-baseline-y-openspec", "file_type": "document", "source_file": "bkt-integration-service/openspec/changes/reconciliar-baseline-y-openspec/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_changes_reconciliar_baseline_y_openspec_design_baseline_problem_context", "label": "Baseline problem: no commits, long paths, mixed technical report, unreconciled tasks", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/reconciliar-baseline-y-openspec/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Branch main has no commits and every file is untracked; Git warns about long paths under docs/mappings; the technical report includes documentation foreign to the service; jira-attachment-processing-hardening keeps tasks unchecked that appear implemented. Without a reviewable baseline new changes, auxiliary docs, credentials and generated output cannot be told apart."}, {"id": "bkt_integration_service_openspec_changes_reconciliar_baseline_y_openspec_design_explicit_inventory_before_baseline", "label": "Explicit inventory before baseline", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/reconciliar-baseline-y-openspec/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each path classified as versionar, generada, local, sensible or pendiente; .gitignore covers local envs, node_modules, dist, coverage, logs, temporary and regenerable output; initial commit remains a manual step. Alternative discarded: git add . because it does not allow reviewing sensitive data."}, {"id": "bkt_integration_service_openspec_changes_reconciliar_baseline_y_openspec_design_evidence_based_reconciliation", "label": "Evidence-based reconciliation of OpenSpec tasks", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/reconciliar-baseline-y-openspec/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each pending checkbox maps to implemented and tested, implemented without test, not implemented, or no longer applicable; only the first is marked complete and the second requires the missing test first."}, {"id": "bkt_integration_service_openspec_changes_reconciliar_baseline_y_openspec_design_short_alias_context_directories", "label": "Short alias for documentary context directories (e.g. pilot-local)", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/reconciliar-baseline-y-openspec/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Context folders use a short stable alias while catalog.json and the dictionary keep tenantId, projectId and itsmId; Markdown references are updated atomically. Alternative discarded: relying only on core.longpaths since some tools still limit paths."}, {"id": "bkt_integration_service_openspec_changes_reconciliar_baseline_y_openspec_design_scoped_technical_report", "label": "Scoped technical report (src, docs/mappings, openspec)", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/reconciliar-baseline-y-openspec/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Input restricted to src, docs/mappings and openspec; dependencies, coverage, build, logs and old artifacts excluded; regenerated report must declare scope and generation date."}, {"id": "bkt_integration_service_openspec_changes_reconciliar_baseline_y_openspec_design_documentation_as_verifiable_source", "label": "Documentation as verifiable source", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/reconciliar-baseline-y-openspec/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Repair links to nonexistent files, never claim a test or task complete without reproducible output, and document validation results without copying internal payloads."}, {"id": "bkt_integration_service_openspec_changes_reconciliar_baseline_y_openspec_design_env_test_credentials_file", "label": ".env.test credential-bearing file kept out of version control", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/reconciliar-baseline-y-openspec/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "File is never read or copied; versioned templates carry only fictitious example values."}], "edges": [{"source": "bkt_integration_service_openspec_changes_reconciliar_baseline_y_openspec_design", "target": "bkt_integration_service_openspec_changes_reconciliar_baseline_y_openspec_design_baseline_problem_context", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "bkt-integration-service/openspec/changes/reconciliar-baseline-y-openspec/design.md", "source_location": null, "weight": 1.0}, {"source": "bkt_integration_service_openspec_changes_reconciliar_baseline_y_openspec_design", "target": "bkt_integration_service_openspec_changes_reconciliar_baseline_y_openspec_design_explicit_inventory_before_baseline", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "bkt-integration-service/openspec/changes/reconciliar-baseline-y-openspec/design.md", "source_location": null, "weight": 1.0}, {"source": "bkt_integration_service_openspec_changes_reconciliar_baseline_y_openspec_design", "target": "bkt_integration_service_openspec_changes_