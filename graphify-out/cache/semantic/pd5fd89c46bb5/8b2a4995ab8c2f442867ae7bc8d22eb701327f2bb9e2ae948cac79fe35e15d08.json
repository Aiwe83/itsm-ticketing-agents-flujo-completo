{"nodes": [{"id": "bkt_integration_service_openspec_changes_observabilidad_calidad_y_demo_design", "label": "observabilidad-calidad-y-demo design", "file_type": "document", "source_file": "bkt-integration-service/openspec/changes/observabilidad-calidad-y-demo/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_changes_observabilidad_calidad_y_demo_design_explicit_phase_statuses", "label": "Explicit phase statuses (integrationStatus, attachmentStatus, orchestratorStatus)", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/observabilidad-calidad-y-demo/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Boolean successIntegration/successOrchestrator being false is ambiguous (failure, pending or skipped). Three enums with pending, succeeded, failed, skipped make each phase explicit; historical documents are presented through derived compatibility without modification."}, {"id": "bkt_integration_service_openspec_changes_observabilidad_calidad_y_demo_design_liveness_readiness_split", "label": "Liveness (/health) vs readiness (/ready) split", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/observabilidad-calidad-y-demo/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "/health is public, fast and dependency-free; /ready returns 200 only when MongoDB is connected, required indexes exist and at least one valid mapping exists for the configured meshId (else 503), exposing only check names and states."}, {"id": "bkt_integration_service_openspec_changes_observabilidad_calidad_y_demo_design_structured_sanitized_logging", "label": "Structured sanitized JSON logging to stdout/stderr", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/observabilidad-calidad-y-demo/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JSON lines with requestId, ticketKey, jobId, revision, attempt, phase, durationMs, status and reduced error; forbids body, attachments, descriptions, names, emails, tokens and auth headers; Docker handles rotation, no local log files."}, {"id": "bkt_integration_service_openspec_changes_observabilidad_calidad_y_demo_design_incremental_quality_controls", "label": "Incremental quality controls (ESLint 9, Prettier, ordered pipeline)", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/observabilidad-calidad-y-demo/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "eslint.config.js for ESLint 9 and Prettier applied as an isolated mechanical commit; pipeline runs reproducible install, typecheck, format:check, lint, Jest with coverage, production audit, TypeScript build and Docker build in that order."}, {"id": "bkt_integration_service_openspec_changes_observabilidad_calidad_y_demo_design_reproducible_pilot_load_test", "label": "Reproducible pilot load test (2 APIs, 2 workers, 50 concurrent)", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/observabilidad-calidad-y-demo/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Local script sends 50 distinct tickets concurrently against two API replicas and two workers (concurrency five); success means no lost requests, no duplicates, all jobs terminal and p95 reception under one second. Failures are recorded, never hidden by raising the threshold."}, {"id": "bkt_integration_service_openspec_changes_observabilidad_calidad_y_demo_design_short_manual_demo", "label": "Two-minute manual demo (Postman and Compass)", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/observabilidad-calidad-y-demo/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Demo kept separate from the automated load test so the explanation to the responsible stakeholder stays simple: send one ticket and locate raw, translated, execution and job."}, {"id": "bkt_integration_service_openspec_changes_observabilidad_calidad_y_demo_design_legacy_boolean_compatibility", "label": "Temporary compatibility of successIntegration/successOrchestrator booleans", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/observabilidad-calidad-y-demo/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Booleans are kept during a compatibility window and derived from the new enums, never the reverse; retirement date is decided after the pilot."}, {"id": "bkt_integration_service_openspec_changes_observabilidad_calidad_y_demo_design_coverage_thresholds", "label": "Coverage thresholds (69/51/53/70 rising to 75/60 after outbox)", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/observabilidad-calidad-y-demo/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "First gate equals measured baseline (statements 69, branches 51, functions 53, lines 70); after outbox completion statements rise to 75 and branches to 60 while functions and lines cannot regress."}, {"id": "bkt_integration_service_openspec_changes_observabilidad_calidad_y_demo_design_outbox_prerequisite", "label": "Durable outbox as prerequisite of this change", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/observabilidad-calidad-y-demo/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Change is applied after the durable outbox so statuses and load tests reflect real API-to-worker processing."}], "edges": [{"source": "bkt_integration_service_openspec_changes_observabilidad_calidad_y_demo_design_explicit_phase_statuses", "target": "bkt_integration_service_openspec_changes_migrar_contexto_mesh_y_endurecer_integracion_design_executions_collection", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "bkt-integration-service/openspec/changes/observabilidad-calidad-y-demo/design.md", "source_location": null, "weight": 1.0}, {"source": "bkt_integration_service_openspec_changes_observabilidad_calidad_y_demo_design_explicit_phase_statuses", "target": "bkt_integration_service_openspec_changes_migrar_contexto_mesh_y_endurecer_integracion_specs_orchestrator_mesh_contract_spec_asynchronous_delivery_tracing", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "bkt-integration-service/openspec/changes/observabilidad-calidad-y-demo/design.md", "source_location": null, "weight": 1.0}, {"source": "bkt_integration_service_openspec_changes_observabilidad_calidad_y_demo_design", "target": "bkt_integration_service_openspec_changes_observabilidad_calidad_y_demo_proposal", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "bkt-integration-service/openspec/changes/observabilidad-calidad-y-demo/design.md", "source_location": null, "weight": 1.0}, {"source": "bkt_integration_service_openspec_changes_observabilidad_calidad_y_demo_design_explicit_phase_statuses", "target": "bkt_integration_service_openspec_changes_observabilidad_calidad_y_demo_specs_pilot_operability_spec", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "bkt-integration-service/openspec/changes/observabilidad-calidad-y-demo/design.md", "source_location": null, "weight": 1.0}, {"source": "bkt_integration_service_openspe