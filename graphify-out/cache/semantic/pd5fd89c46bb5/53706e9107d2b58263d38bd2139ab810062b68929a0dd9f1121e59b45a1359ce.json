{"nodes": [{"id": "bkt_integration_service_openspec_specs_openapi_response_completeness_spec", "label": "Spec: openapi-response-completeness", "file_type": "document", "source_file": "bkt-integration-service/openspec/specs/openapi-response-completeness/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Defines which HTTP response codes each generated OpenAPI operation must or must not document so the documented set matches real global error handling, rate limiting scope and fallback behavior."}, {"id": "bkt_integration_service_openspec_specs_openapi_response_completeness_spec_documented_error_responses_match_global_handling", "label": "Requirement: documented 404 matches global error handling", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/specs/openapi-response-completeness/spec.md", "source_location": "L9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "notFoundHandler is mounted globally after all routes and can answer any unmatched path reaching a GET operation, so every GET operation documents 404 with ErrorResponse."}, {"id": "bkt_integration_service_openspec_specs_openapi_response_completeness_spec_rate_limit_responses_match_limiter_scope", "label": "Requirement: documented 429 matches rate limiter scope", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/specs/openapi-response-completeness/spec.md", "source_location": "L20", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The limiter in src/app.ts is mounted only on the /api/ prefix: getApiRoot and createIssues document 429 (RateLimitErrorResponse), getHealth must not."}, {"id": "bkt_integration_service_openspec_specs_openapi_response_completeness_spec_default_fallback_error_response", "label": "Requirement: every operation documents a default error response", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/specs/openapi-response-completeness/spec.md", "source_location": "L31", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "exceptionHandler is the last global middleware and can return an error for any unhandled failure on any operation."}, {"id": "bkt_integration_service_openspec_specs_openapi_response_completeness_spec_no_responses_for_unexhibited_behavior", "label": "Requirement: no 406/415 documented for behavior the service lacks", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/specs/openapi-response-completeness/spec.md", "source_location": "L38", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The service does no content negotiation and express.json() does not reject unexpected Content-Type with 415; a wrong content type falls through to a 400 validation error."}, {"id": "bkt_integration_service_openspec_specs_openapi_response_completeness_spec_gethealth_operation", "label": "OpenAPI operation getHealth", "file_type": "concept", "source_file": "bkt-integration-service/openspec/specs/openapi-response-completeness/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_specs_openapi_response_completeness_spec_getapiroot_operation", "label": "OpenAPI operation getApiRoot", "file_type": "concept", "source_file": "bkt-integration-service/openspec/specs/openapi-response-completeness/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_specs_openapi_response_completeness_spec_createissues_operation", "label": "OpenAPI operation createIssues", "file_type": "concept", "source_file": "bkt-integration-service/openspec/specs/openapi-response-completeness/spec.md", "source_location": null, "source_url": null, "captured_at"