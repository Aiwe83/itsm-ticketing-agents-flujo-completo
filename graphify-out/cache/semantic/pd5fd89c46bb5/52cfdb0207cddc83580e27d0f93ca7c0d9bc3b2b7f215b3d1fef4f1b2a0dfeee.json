{"nodes": [{"id": "bkt_integration_service_openspec_changes_migrar_contexto_mesh_y_endurecer_integracion_design", "label": "migrar-contexto-mesh-y-endurecer-integracion design", "file_type": "document", "source_file": "bkt-integration-service/openspec/changes/migrar-contexto-mesh-y-endurecer-integracion/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_changes_migrar_contexto_mesh_y_endurecer_integracion_design_meshid_single_operating_context", "label": "meshId as single operating context", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/migrar-contexto-mesh-y-endurecer-integracion/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MESH_ID (required, non-empty env var) replaces the triple tenantId/projectId/itsmId across code, models, mappings, fixtures and pending OpenSpec. Keeping the triple as permanent compatibility was rejected because it would duplicate sources of truth and allow incoherent documents."}, {"id": "bkt_integration_service_openspec_changes_migrar_contexto_mesh_y_endurecer_integracion_design_mesh_indexes", "label": "meshId indexes (meshId_1 and unique mapping compound)", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/migrar-contexto-mesh-y-endurecer-integracion/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Simple meshId_1 index on four collections; unique compound {meshId, sourceField, targetField} on mappings is created only after dry-run confirms no duplicates."}, {"id": "bkt_integration_service_openspec_changes_migrar_contexto_mesh_y_endurecer_integracion_design_deterministic_shared_ticket_id", "label": "Deterministic shared _id ${meshId}:${ticketKey} (1:1 raw/translated)", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/migrar-contexto-mesh-y-endurecer-integracion/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raw (itsm_tickets) and translated (tickets) documents use exactly the same _id built from meshId and payload.key; upsert keeps a single raw and single translated on retries. _id is immutable so migration copies to a new DB with recalculated IDs."}, {"id": "bkt_integration_service_openspec_changes_migrar_contexto_mesh_y_endurecer_integracion_design_execution_record_id_vs_stored_ticket_id", "label": "executionRecordId vs storedTicketId vs ticketKey", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/migrar-contexto-mesh-y-endurecer-integracion/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Execution._id (executionRecordId) identifies each attempt; storedTicketId is the shared raw/translated _id; HTTP executionId is kept temporarily as alias of the execution record to avoid breaking consumers. Prevents interchangeable use of the two IDs."}, {"id": "bkt_integration_service_openspec_changes_migrar_contexto_mesh_y_endurecer_integracion_design_raw_ticket_lifecycle", "label": "Raw ticket lifecycle (persisted -> translated | failed)", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/migrar-contexto-mesh-y-endurecer-integracion/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raw ticket saved as persisted, becomes translated after translated upsert, failed on mapping or later persistence failure; attachment or orchestrator failures do not downgrade a translated ticket. The received status is retired and migrated to persisted."}, {"id": "bkt_integration_service_openspec_changes_migrar_contexto_mesh_y_endurecer_integracion_design_orchestrator_flat_payload_contract", "label": "Orchestrator flat payload contract (rol, ticket_id, mesh_id, execution_id)", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/migrar-contexto-mesh-y-endurecer-integracion/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ticket_id is the Jira key, mesh_id comes from MESH_ID, execution_id is storedTicketId, rol comes from ORCHESTRATOR_ROLE (replaces INITIAL_ROL). Using Execution._id as execution_id was rejected because the contract demands the _id stored in itsm_tickets. Snake_case is confined to the external serializer."}, {"id": "bkt_integration_service_openspec_changes_migrar_contexto_mesh_y_endurecer_integracion_design_error_responses_without_stack", "label": "Error responses without stack; sanitized diagnostics in logs", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/migrar-contexto-mesh-y-endurecer-integracion/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ErrorResponse no longer declares stack and no environment includes it in JSON; the logger keeps the full error and stack plus requestId, method, path and code, but never body, attachments, descriptions, tokens, cookies or auth headers."}, {"id": "bkt_integration_service_openspec_changes_migrar_contexto_mesh_y_endurecer_integracion_design_bson_dates_and_iso_serialization", "label": "BSON Date persistence and ISO 8601 UTC serialization", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/migrar-contexto-mesh-y-endurecer-integracion/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All MongoDB dates stored as BSON Date (imported mappings kept createdAt/updatedAt as ISO strings); migration converts valid strings and reports invalid ones as conflicts. API and logs use one utility to emit YYYY-MM-DDTHH:mm:ss.sssZ; no localized representations stored."}, {"id": "bkt_integration_service_openspec_changes_migrar_contexto_mesh_y_endurecer_integracion_design_mongodb_migration_dry_run_apply", "label": "MongoDB migration with dry-run and apply (db:migrate-mesh)", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/migrar-contexto-mesh-y-endurecer-integracion/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Commands db:migrate-mesh:dry-run and db:migrate-mesh:apply copy caf_agents into integration-service, replacing context, recalculating IDs, updating ticketList.transformedTicketId and converting dates while preserving Execution._id. Apply requires explicit target confirmation, never deletes the source and is idempotent (unchanged vs conflict)."}, {"id": "bkt_integration_service_openspec_changes_migrar_contexto_mesh_y_endurecer_integracion_design_docker_and_configuration_naming", "label": "Docker and configuration naming (integration-service)", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/migrar-contexto-mesh-y-endurecer-integracion/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compose project and app service renamed integration-service; Mongo service stays mongo; no fixed container_name so replicas can scale; rebuild with docker compose up -d --build --force-recreate to avoid validating a stale image. Design says the current volume does not change, whereas spec and tasks require a fresh volume."}, {"id": "bkt_integration_service_openspec_changes_migrar_contexto_mesh_y_endurecer_integracion_design_openspec_and_documentation_reconciliation", "label": "OpenSpec and documentation reconciliation", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/migrar-contexto-mesh-y-endurecer-integracion/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pending OpenSpec that depend on old IDs are updated before being applied; completed OpenSpec are kept as history and marked as belonging to the previous context model."}, {"id": "bkt_integration_service_openspec_changes_migrar_contexto_mesh_y_endurecer_integracion_design_rollback_strategy", "label": "Rollback strategy (return to caf_agents)", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/migrar-contexto-mesh-y-endurecer-integracion/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Source database is never modified, so rollback is restoring previous image and configuration pointing at caf_agents; tickets accepted during the new-service window are reprocessed in a controlled way afterwards."}, {"id": "bkt_integration_service_openspec_changes_migrar_contexto_mesh_y_endurecer_integracion_design_itsm_tickets_collection", "label": "itsm_tickets collection (raw Jira tickets)", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/migrar-contexto-mesh-y-endurecer-integracion/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_changes_migrar_contexto_mesh_y_endurecer_integracion_design_tickets_collection", "label": "tickets collection (translated tickets)", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/migrar-contexto-mesh-y-endurecer-integracion/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_changes_migrar_contexto_mesh_y_endurecer_integracion_design_executions_collection", "label": "executions collection (processing attempts)", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/migrar-contexto-mesh-y-endurecer-integracion/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_changes_migrar_contexto_mesh_y_endurecer_integracion_design_mappings_collection", "label": "mappings collection (field mappings)", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/migrar-contexto-mesh-y-endurecer-integracion/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_changes_migrar_contexto_mesh_y_endurecer_integracion_design_caf_agents_database", "label": "caf_agents database (legacy source)", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/migrar-contexto-mesh-y-endurecer-integracion/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_changes_migrar_contexto_mesh_y_endurecer_integracion_design_integration_service_database", "label": "integration-service database (migration target)", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/migrar-contexto-mesh-y-endurecer-integracion/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_changes_migrar_contexto_mesh_y_endurecer_integracion_design_outbox_openspec_out_of_scope", "label": "procesamiento-durable-escalable-outbox change (out of scope)", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/migrar-contexto-mesh-y-endurecer-integracion/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Outbox and workers are defined in another OpenSpec and explicitly not implemented by this change."}], "edges": [{"source": "bkt_integration_service_openspec_changes_migrar_contexto_mesh_y_endurecer_integracion_design", "target": "bkt_integration_service_openspec_changes_migrar_contexto_mesh_y_endurecer_integracion_proposal", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "bkt-integration-service/openspec/changes/migrar-contexto-mesh-y-endurecer-integracion/design.md", "source_location": null, "weight": 1.0}, {"source": "bkt_integration_service_openspec_changes_migrar_contexto_mesh_y_endurecer_integracion_design_meshid_single_operating_context", "target": "bkt_integration_service_openspec_changes_migrar_contexto_mesh_y_endurecer_integracion_specs_mesh_ticket_persistence_spec", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "bkt-integration-service/openspec/changes/migrar-contexto-mesh-y-endurecer-integracion/design.md", "source_location": null, "weight": 1.0}, {"source": "bkt_integration_service_openspec_changes_migrar_contexto_mesh_y_endurecer_integracion_design_meshid_single_operating_context", "target": "bkt_integration_service_openspec_changes_migrar_contexto_mesh_y_endurecer_integracion_design_mesh_indexes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "bkt-integration-service/openspec/changes/migrar-contexto-mesh-y-endurecer-integracion/design.md", "source_location": null, "weight": 1.0}, {"source": "bkt_integration_service_openspec_changes_migrar_contexto_mesh_y_endurecer_integracion_design_mesh_indexes", "target": "bkt_integration_service_openspec_changes_migrar_contexto_mesh_y_endurecer_integracion_design_itsm_tickets_collection", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "bkt-integration-service/openspec/changes/migrar-contexto-mesh-y-endurecer-integracion/design.md", "source_location": null, "weight": 1.0}, {"sour