{"nodes": [{"id": "bkt_integration_service_openspec_changes_archive_2026_08_31_jira_mongo_agentes_fase2_design", "label": "jira-mongo-agentes-fase2: design.md", "file_type": "document", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-31-jira-mongo-agentes-fase2/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_31_jira_mongo_agentes_fase2_design_raw_translated_execution_flow", "label": "Raw -> translated -> execution flow", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-31-jira-mongo-agentes-fase2/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Saving the raw ticket first and the translated one after separates the source of truth from the agent-consumable version. Storing only the translated document was rejected because it loses traceability and hinders debugging."}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_31_jira_mongo_agentes_fase2_design_mappings_as_translation_contract", "label": "Mappings as translation contract", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-31-jira-mongo-agentes-fase2/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Translation depends on data stored in Mongo rather than hardcoded fields. Mapping fields in code was rejected as rigid and costly to maintain."}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_31_jira_mongo_agentes_fase2_design_rename_statussp_to_status", "label": "Rename statusSp to status (BREAKING)", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-31-jira-mongo-agentes-fase2/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Translated field should resemble Jira naming and avoid a confusing exception. Keeping both names or creating an alias was rejected because it keeps ambiguity and complicates the contract. Open question: whether any external consumer still expects statusSp."}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_31_jira_mongo_agentes_fase2_design_fire_and_forget_orchestrator_notification", "label": "Fire-and-forget orchestrator notification", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-31-jira-mongo-agentes-fase2/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The incoming request must not depend on orchestrator latency or retries. Waiting for the response was rejected because it couples HTTP response time to the agent backend. Risk: temporal gap between HTTP response and real orchestrator result, mitigated by asynchronous Execution updates and error recording."}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_31_jira_mongo_agentes_fase2_design_execution_traceability", "label": "Execution as traceability point", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-31-jira-mongo-agentes-fase2/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Even with asynchronous notification, the Execution must reflect whether notification was attempted and with what result. Not recording the later result was rejected because it reduces operational visibility."}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_31_jira_mongo_agentes_fase2_design_single_ticket_contract", "label": "Single ticket per request contract", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-31-jira-mongo-agentes-fase2/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No batch support. The one-ticket contract forces clients to split batches; a clear validation error is returned and documented in the test plan."}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_31_jira_mongo_agentes_fase2_design_post_api_v1_issues", "label": "POST /api/v1/issues endpoint", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-31-jira-mongo-agentes-fase2/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_31_jira_mongo_agentes_fase2_design_orchestrator", "label": "Orchestrator (agents backend)", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-31-jira-mongo-agentes-fase2/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_31_jira_mongo_agentes_fase2_design_itsm_tickets_collection", "label": "itsm_tickets collection (raw Jira tickets)", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-31-jira-mongo-agentes-fase2/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_31_jira_mongo_agentes_fase2_design_tickets_collection", "label": "tickets collection (translated tickets)", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-31-jira-mongo-agentes-fase2/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_31_jira_mongo_agentes_fase2_design_mappings_collection", "label": "mappings collection", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-31-jira-mongo-agentes-fase2/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_31_jira_mongo_agentes_fase2_design_executions_collection", "label": "executions collection", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-31-jira-mongo-agentes-fase2/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_31_jira_mongo_agentes_fase2_design_no_historical_migration", "label": "No automatic migration of historical documents", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-31-jira-mongo-agentes-fase2/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Historical documents may keep old names or states; they are not migrated and the demo uses only updated data. Rollback reverts the application version without touching historical documents."}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_31_jira_mongo_agentes_fase2_design_open_question_attachment_extraction", "label": "Open question: attachment extraction in same or separate capability", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-31-jira-mongo-agentes-fase2/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "bkt_integration_service_openspec_changes_archive_2026_08_31_jira_mongo_agentes_fase2_design", "target": "bkt_integration_service_openspec