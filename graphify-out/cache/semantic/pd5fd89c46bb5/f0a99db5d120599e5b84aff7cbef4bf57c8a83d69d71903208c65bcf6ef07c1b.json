{"nodes": [{"id": "bkt_integration_service_openspec_changes_endurecer_ingesta_jira_piloto_design", "label": "endurecer-ingesta-jira-piloto design", "file_type": "document", "source_file": "bkt-integration-service/openspec/changes/endurecer-ingesta-jira-piloto/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_changes_endurecer_ingesta_jira_piloto_design_api_key_authentication", "label": "API key authentication via configurable header", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/endurecer-ingesta-jira-piloto/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Middleware protects /api/ routes, compares key in constant time (timingSafeEqual) and answers a reduced 401. JWT was discarded: calls are service-to-service with no user identity or token issuance lifecycle. /health stays unauthenticated. Design names variable INTEGRATION_API_KEY and header API_KEY_HEADER."}, {"id": "bkt_integration_service_openspec_changes_endurecer_ingesta_jira_piloto_design_secure_network_configuration", "label": "Validated secure network configuration at startup", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/endurecer-ingesta-jira-piloto/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TRUST_PROXY_HOPS as non-negative integer replaces hardcoded trust proxy 1; CORS_CREDENTIALS=true with CORS_ORIGIN=* fails at startup; rate limiter reuses the validated proxy config. Mitigates misconfigured proxy altering rate limiting."}, {"id": "bkt_integration_service_openspec_changes_endurecer_ingesta_jira_piloto_design_minimal_ingestion_response", "label": "Minimal ingestion response (no raw or translated ticket echo)", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/endurecer-ingesta-jira-piloto/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Response returns ticketId, issueId, success, errors, storedTicketId and receivedAt but not issue nor transformedIssue, to reduce sensitive data exposure; 201 preserved, zero or many tickets still 400. Demo guides must query full document in MongoDB."}, {"id": "bkt_integration_service_openspec_changes_endurecer_ingesta_jira_piloto_design_sensitive_data_redacted_logging", "label": "Logging without payloads or secrets", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/endurecer-ingesta-jira-piloto/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Logger redacts authorization, API key, cookies and passwords case-insensitively; ingestion events log request ID, execution ID, ticket key, result and duration but never the body."}, {"id": "bkt_integration_service_openspec_changes_endurecer_ingesta_jira_piloto_design_controlled_dependency_updates", "label": "Controlled dependency updates", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/endurecer-ingesta-jira-piloto/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Update Mongoose, Mammoth, Express Rate Limit and UUID first, in small groups running the suite after each; remove bcryptjs and jsonwebtoken (and types) only if repository-wide search confirms no usage. No business logic change."}, {"id": "bkt_integration_service_openspec_changes_endurecer_ingesta_jira_piloto_design_env_example_misalignment", "label": ".env.example vs real orchestrator variables misalignment", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/endurecer-ingesta-jira-piloto/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": ".env.example uses ORCHESTRATOR_URL while the code requires ORCHESTRATOR_BASE_URL and ORCHESTRATOR_ENDPOINT; must be aligned using dummy values only."}], "edges": [{"source": "bkt_integration_service_openspec_changes_endurecer_ingesta_jira_piloto_design", "target": "bkt_integration_service_openspec_changes_endurecer_ingesta_jira_piloto_proposal", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "bkt-integration-service/openspec/changes/endurecer-ingesta-jira-piloto/design.md", "source_location": null, "weight": 1.0}, {"source": "bkt_integration_service_openspec_changes_endurecer_ingesta_jira_piloto_design_api_key_authentication", "target": "bkt_integration_service_openspec_changes_endurecer_ingesta_jira_piloto_proposal_post_api_v1_issues_endpoint", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "bkt-integration-service/openspec/changes/endurecer-ingesta-jira-piloto/design.md", "source_location": null, "weight": 1.0}, {"source": "bkt_integration_service_openspec_changes_endurecer_ingesta_jira_piloto_design_api_key_authentication", "target": "bkt_integration_service_openspec_changes_endurecer_ingesta_jira_piloto_specs_secure_jira_ingestion_spec", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "bkt-integration-service/openspec/changes/endurecer-ingesta-jira-piloto/design.md", "source_location": null, "weight": 1.0}, {"source": "bkt_integration_service_openspec_changes_endurecer_ingesta_jira_piloto_design_secure_network_configuration", "target": "bkt_integration_service_openspec_changes_endurecer_ingesta_jira_piloto_specs_secure_jira_ingestion_spec", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "bkt-integration-service/openspec/changes/endurecer-ingesta-jira-piloto/design.md", "source_location": nu