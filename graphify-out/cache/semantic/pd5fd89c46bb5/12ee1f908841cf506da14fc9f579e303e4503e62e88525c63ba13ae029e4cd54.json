service_openspec_changes_archive_2026_08_14_completar_model_reference_y_notas_funcionales_mapping_catalog_review_design_model_reference_doc", "label": "model-reference document (one per functional model section, with sanitized body text)", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-14-completar-model-reference-y-notas-funcionales-mapping-catalog-review/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Earlier documents only carried sourcePath and lineCount, which was not enough to explain the functional model in a demo; the body field makes each section readable directly in Compass."}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_14_completar_model_reference_y_notas_funcionales_mapping_catalog_review_design_gotcha_doc", "label": "gotcha document (note carrying scope functional or design)", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-14-completar-model-reference-y-notas-funcionales-mapping-catalog-review/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The scope attribute distinguishes notes extracted from the functional model from design warnings about the catalog or projection, so they are not mixed."}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_14_completar_model_reference_y_notas_funcionales_mapping_catalog_review_design_gotcha_scope_functional", "label": "gotcha scope: functional (notes extracted from functional model)", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-14-completar-model-reference-y-notas-funcionales-mapping-catalog-review/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_14_completar_model_reference_y_notas_funcionales_mapping_catalog_review_design_gotcha_scope_design", "label": "gotcha scope: design (design warnings of catalog or projection)", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-14-completar-model-reference-y-notas-funcionales-mapping-catalog-review/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_14_completar_model_reference_y_notas_funcionales_mapping_catalog_review_design_functional_model_source", "label": "Functional model source: docs/mappings/modelo_de_datos_mappeos_nuevos/json_modelo_datos _1.md", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-14-completar-model-reference-y-notas-funcionales-mapping-catalog-review/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_14_completar_model_reference_y_notas_funcionales_mapping_catalog_review_design_generator_rules", "label": "Review seed generator rules (split by section, deterministic _id, fixed meshId, fail on content.statusSp, never drop())", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-14-completar-model-reference-y-notas-funcionales-mapping-catalog-review/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_14_completar_model_reference_y_notas_funcionales_mapping_catalog_review_design_deterministic_ids_idempotent_upsert", "label": "Deterministic _id and idempotent upsert loading (bulkWrite, updateOne, upsert true; no drop())", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-14-