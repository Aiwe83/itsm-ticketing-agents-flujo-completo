{"nodes": [{"id": "bkt_integration_service_openspec_changes_procesamiento_durable_escalable_outbox_design", "label": "Design: procesamiento-durable-escalable-outbox", "file_type": "document", "source_file": "bkt-integration-service/openspec/changes/procesamiento-durable-escalable-outbox/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_changes_procesamiento_durable_escalable_outbox_design_issueservice_in_memory_fire_and_forget", "label": "IssueService in-memory fire-and-forget postProcessTickets", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/procesamiento-durable-escalable-outbox/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "IssueService saves raw and translated ticket, completes the execution and launches postProcessTickets() with void ...catch(); the work exists only in memory, is lost if the process ends, and replicas do not coordinate who processes each ticket."}, {"id": "bkt_integration_service_openspec_changes_procesamiento_durable_escalable_outbox_design_mongodb_replica_set", "label": "MongoDB replica set (single node local, managed in shared envs)", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/procesamiento-durable-escalable-outbox/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Needed for transactions; local init automated in Docker and MongoMemoryReplSet used in integration tests. MongoDB is already the persistent dependency so no other infrastructure is needed."}, {"id": "bkt_integration_service_openspec_changes_procesamiento_durable_escalable_outbox_design_transactional_mongo_outbox", "label": "Transactional MongoDB outbox", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/procesamiento-durable-escalable-outbox/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One transaction commits translated ticket, raw status translated, integration summary and job upsert; on failure no new ticket exists without its job and raw is traced failed outside the transaction. Alternative discarded: two independent writes leave a crash window. Non-goals: no Kafka, RabbitMQ, Redis; no global ordering; no batches."}, {"id": "bkt_integration_service_openspec_changes_procesamiento_durable_escalable_outbox_design_processing_jobs_document", "label": "processing_jobs document (id meshId:ticketKey)", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/procesamiento-durable-escalable-outbox/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Holds meshId, ticketKey, transformedTicketId, executionId, revision, processedRevision, claimedRevision, status (pending|processing|retry|succeeded|failed), phase (attachments|orchestrator), attempts, nextAttemptAt, leaseOwner, leaseUntil, lastError; no payload copy - worker recovers raw, translated and execution by deterministic IDs."}, {"id": "bkt_integration_service_openspec_changes_procesamiento_durable_escalable_outbox_design_concurrent_revisions", "label": "Revision counter for concurrent deliveries", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/procesamiento-durable-escalable-outbox/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each valid delivery increments revision; if the job is processing the upsert only bumps revision and execution reference; on finish the worker compares claimedRevision with revision and returns to pending if it advanced."}, {"id": "bkt_integration_service_openspec_changes_procesamiento_durable_escalable_outbox_design_atomic_lease_claiming", "label": "Atomic lease claiming via findOneAndUpdate", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/procesamiento-durable-escalable-outbox/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unique workerId claims an eligible or expired job setting status=processing, leaseOwner, leaseUntil, claimedRevision. Defaults: WORKER_CONCURRENCY 5, polling 1000 ms, lease 120000 ms, heartbeat 30000 ms; expired lease can be reclaimed by another replica."}, {"id": "bkt_integration_service_openspec_changes_procesamiento_durable_escalable_outbox_design_resumable_phases", "label": "Resumable phases: attachments then orchestrator", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/procesamiento-durable-escalable-outbox/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Enrichment from attachments is persisted before switching phase to orchestrator so normal orchestrator retries do not re-download attachments; only status succeeded means the final phase completed."}, {"id": "bkt_integration_service_openspec_changes_procesamiento_durable_escalable_outbox_design_retry_policy_five_attempts", "label": "Retry policy: five attempts with backoff 5s/30s/2m/10m/30m", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/procesamiento-durable-escalable-outbox/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "After the fifth failure the job stays failed, the execution records the error and the translated ticket is neither deleted nor marked as integration failure. Validation errors or missing referenced ticket are non-retryable; network, timeout, orchestrator 5xx are retryable; orchestrator 4xx definitive except 408 and 429."}, {"id": "bkt_integration_service_openspec_changes_procesamiento_durable_escalable_outbox_design_process_roles", "label": "PROCESS_ROLE api|worker|all from one artifact", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/procesamiento-durable-escalable-outbox/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same compiled artifact and image serve api (Express without consumer), worker (consumer only) and all (local dev). Graceful shutdown stops new claims, waits for active jobs up to lease limit and closes MongoDB."}, {"id": "bkt_integration_service_openspec_changes_procesamiento_durable_escalable_outbox_design_external_idempotency_key", "label": "X-Idempotency-Key <jobId>:<claimedRevision>", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/procesamiento-durable-escalable-outbox/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Retries of the same revision keep the key. Internal guarantee prevents two active claims; removing duplicates after a timeout requires the orchestrator to honor the header (open question outside this repository)."}, {"id": "bkt_integration_service_openspec_changes_procesamiento_durable_escalable_outbox_design_response_processing_queued", "label": "201 response with processingQueued and deprecated orchestratorDispatched", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/procesamiento-durable-escalable-outbox/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "processingQueued: true is added; orchestratorDispatched is kept during a transition and reflects that post-processing was accepted, not that the external call finished; documented as deprecated."}], "edges": [{"source": "bkt_integration_service_openspec_changes_procesamiento_durable_escalable_outbox_design", "target": "bkt_integration_service_openspec_changes_procesamiento_durable_escalable_outbox_design_issueservice_in_memory_fire_and_forget", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "bkt-integration-service/openspec/changes/procesamiento-durable-escalable-outbox/design.md", "source_location": null, "weight": 1.0}, {"source": "bkt_integration_service_openspec_changes_procesamiento_durable_escalable_outbox_design", "target": "bkt_integration_service_openspec_changes_procesamiento_durable_escalable_outbox_design_mongodb_replica_set", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "bkt-integration-service/openspec/changes/procesamiento-durable-escalable-outbox/design.md", "source_location": null, "weight": 1.0}, {"source": "bkt_integration_service_openspec_changes_procesamiento_durable_escalable_outbox_design", "target": "bkt_integration_service_openspec_changes_procesamiento_durable_escalable_outbox_design_transactional_mongo_outbox", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "bkt-integration-service/openspec/changes/procesamiento-durable-escalable-outbox/design.md", "source_location": null, "weight": 1.0}, {"source": "bkt_integration_service_openspec_changes_procesamiento_durable_escalable_outbox_design", "target": "bkt_integration_service_openspec_changes_procesamiento_durable_escalable_outbox_design_processing_jobs_document", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "bkt-integration-service/openspec/changes/procesamiento-durable-escalable-outbox/design.md", "source_location": null, "weight": 1.0}, {"source": "bkt_integration_service_openspec_changes_procesamiento_durable_escalable_outbox_design", "target": "bkt_integration_service_openspec_changes_procesamiento_durable_escalable_outbox_design_concurrent_revisions", "relation": "