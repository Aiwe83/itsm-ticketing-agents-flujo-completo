{"nodes": [{"id": "bkt_integration_service_docs_mappings_readme", "label": "docs/mappings/README - Catalogo de mappings Jira", "file_type": "document", "source_file": "bkt-integration-service/docs/mappings/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_docs_mappings_readme_evidence_candidates_consumable_separation", "label": "Separation of evidence, candidates and consumable mappings", "file_type": "rationale", "source_file": "bkt-integration-service/docs/mappings/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps sanitized evidence, unconfirmed candidate fields and confirmed consumable mappings apart; Git stays the source of truth and the Mongo review collection is only a regenerable demo view."}, {"id": "bkt_integration_service_docs_mappings_readme_evidence_promotion_flow", "label": "Raw data to docs promotion flow (review, sanitize, copy, classify, review view)", "file_type": "rationale", "source_file": "bkt-integration-service/docs/mappings/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raw files are working material, never loaded directly to MongoDB; only sanitized useful parts are copied to docs/mappings and classified before any controlled load."}, {"id": "bkt_integration_service_docs_mappings_readme_raw_input_data_datos_para_crear_proyecto", "label": "Raw input data (context_para_el_proyecto/datos_para_crear_proyecto)", "file_type": "concept", "source_file": "bkt-integration-service/docs/mappings/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_docs_mappings_readme_datos_basicos_27_fields", "label": "Datos basicos functional reference (27 fields)", "file_type": "concept", "source_file": "bkt-integration-service/docs/mappings/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_docs_mappings_readme_field_decision_states", "label": "Field decision states: confirmed, pending-validation, excluded, engineBlocked", "file_type": "concept", "source_file": "bkt-integration-service/docs/mappings/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_docs_mappings_readme_catalog_json", "label": "catalog.json (consumable mappings catalog, contexts/pilot-local)", "file_type": "document", "source_file": "bkt-integration-service/docs/mappings/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_docs_mappings_readme_evidence_pilot_local_dir", "label": "docs/mappings/evidence/pilot-local (sanitized evidence)", "file_type": "concept", "source_file": "bkt-integration-service/docs/mappings/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_docs_mappings_readme_contexts_pilot_local_dir", "label": "docs/mappings/contexts/pilot-local (catalog and data matrices)", "file_type": "concept", "source_file": "bkt-integration-service/docs/mappings/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_docs_mappings_readme_modelo_de_datos_mappeos_nuevos_dir", "label": "docs/mappings/modelo_de_datos_mappeos_nuevos (new data model copy)", "file_type": "concept", "source_file": "bkt-integration-service/docs/mappings/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_docs_mappings_readme_build_mongo_review_seed_script", "label": "scripts/build-mongo-review-seed.mjs (documentary seed generator)", "file_type": "code", "source_file": "bkt-integration-service/docs/mappings/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_docs_mappings_readme_mapping_catalog_review_collection", "label": "mapping_catalog_review collection (documentary MongoDB view)", "file_type": "rationale", "source_file": "bkt-integration-service/docs/mappings/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Documentary view of the catalog for Compass, deliberately separated from the operational mappings collection (sentinel mesh REVIEW-NOT-OPERATIONAL); real mappings are never edited from Compass."}, {"id": "bkt_integration_service_docs_mappings_readme_review_doc_types", "label": "mapping_catalog_review docTypes: field, model-reference, gotcha, example-ticket (184 docs)", "file_type": "concept", "source_file": "bkt-integration-service/docs/mappings/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_docs_mappings_readme_generator_upsert_only_rule", "label": "Generator upsert-only rule (never drop; orphan _id removed with explicit deleteOne)", "file_type": "rationale", "source_file": "bkt-integration-service/docs/mappings/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Upsert by _id never touches or deletes documents whose _id was renamed, so orphans must be found by comparing Mongo _ids to the regenerated seed and deleted explicitly, never with drop()."}, {"id": "bkt_integration_service_docs_mappings_readme_mappings_collection", "label": "mappings collection (operational, real mappings)", "file_type": "concept", "source_file": "bkt-integration-service/docs/mappings/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_docs_mappings_readme_loaded_fields_gap", "label": "Only 10 of 163 field docs are loaded in mappings", "file_type": "rationale", "source_file": "bkt-integration-service/docs/mappings/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The bottleneck is not technical: the 139 pending-validation fields need business to confirm meaning and real Jira field before implementation."}, {"id": "bkt_integration_service_docs_mappings_readme_native_evidence_not_confirmation", "label": "(nativo) evidence does not promote fields to confirmed (Entorno and Grado de urgencia conflicts unresolved)", "file_type": "rationale", "source_file": "bkt-integration-service/docs/mappings/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A field existing in the Jira API only proves existence, not the exact read path or internal target; Entorno has two candidate Jira sources and Grado de urgencia must not be merged with priority/severityLevel."}, {"id": "bkt_integration_service_docs_mappings_readme_catalog_to_mongodb_promotion_pipeline", "label": "Promotion pipeline catalog.json to MongoDB", "file_type": "concept", "source_file": "bkt-integration-service/docs/mappings/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_docs_mappings_readme_mapping_catalog_service", "label": "src/services/mapping-catalog.service.ts", "file_type": "code", "source_file": "bkt-integration-service/docs/mappings/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_docs_mappings_readme_pnpm_mappings_dry_run", "label": "pnpm mappings:dry-run (read-only diff)", "file_type": "concept", "source_file": "bkt-integration-service/docs/mappings/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_docs_mappings_readme_pnpm_mappings_apply_confirm_version", "label": "pnpm mappings:apply --confirm-version=<catalogVersion>", "file_type": "rationale", "source_file": "bkt-integration-service/docs/mappings/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "catalogVersion changes on every version bump, so the confirmation value cannot be fixed in the npm script unlike --confirm=integration-service in db:migrate-mesh:apply; apply also refuses on meshId mismatch or conflicts."}, {"id": "bkt_integration_service_docs_mappings_readme_db_migrate_mesh_apply", "label": "db:migrate-mesh:apply --confirm=integration-service", "file_type": "concept", "source_file": "bkt-integration-service/docs/mappings/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_docs_mappings_readme_logical_identity_meshid_source_target", "label": "Logical identity meshId + sourceField + targetField", "file_type": "rationale", "source_file": "bkt-integration-service/docs/mappings/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Comparing by logical identity (never by _id) avoids duplicating mappings already loaded by hand with a random UUID _id."}, {"id": "bkt_integration_service_docs_mappings_readme_customfield_resolution_flow", "label": "Flow to resolve customfields (real Jira id, name, type, read path, internal target)", "file_type": "concept", "source_file": "bkt-integration-service/docs/mappings/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_docs_mappings_readme_customfield_candidates", "label": "customfield_* candidates (customfield_10147, customfield_10152)", "file_type": "rationale", "source_file": "bkt-integration-service/docs/mappings/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A customfield seen in a payload is not enough to create a mapping; it needs Jira metadata, business confirmation or a sanitized payload that identifies it."}, {"id": "bkt_integration_service_docs_mappings_readme_mapping_rules", "label": "Mapping rules (one mapping per field, meshId grouping, content.status, no statusSp)", "file_type": "rationale", "source_file": "bkt-integration-service/docs/mappings/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No generic fields-to-object mapping; each mapping has sourceField, targetField, transformer, required, description and options; underscore-prefixed keys are documentary and never inserted in MongoDB; customfield ids are never invented; legacy statusSp is not recovered."}, {"id": "bkt_integration_service_docs_mappings_readme_meshid_context_identifier", "label": "meshId operational context identifier", "file_type": "concept", "source_file": "bkt-integration-service/docs/mappings/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_docs_mappings_readme_priority_vs_urgency", "label": "priority (content.severityLevel) is not urgency", "file_type": "concept", "source_file": "bkt-integration-service/docs/mappings/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_docs_mappings_readme_attachments_not_regular_mappings", "label": "Attachments are not regular mappings (content.attachedDocuments)", "file_type": "concept",