{"nodes": [{"id": "bkt_jira_triggers_openspec_changes_archive_2026_08_18_add_jira_forge_trigger_demo_design", "label": "Design: add-jira-forge-trigger-demo", "file_type": "document", "source_file": "bkt-jira-triggers/openspec/changes/archive/2026-08-18-add-jira-forge-trigger-demo/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Design of a standalone Jira Forge demo that captures issue events via triggers, sanitizes traces, builds (but never sends) the future integration-service request and documents integration boundaries."}, {"id": "bkt_jira_triggers_openspec_changes_archive_2026_08_18_add_jira_forge_trigger_demo_design_standalone_forge_project", "label": "Decision: standalone Forge project", "file_type": "rationale", "source_file": "bkt-jira-triggers/openspec/changes/archive/2026-08-18-add-jira-forge-trigger-demo/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps trigger research separate from the production ingestion service so uncertain event behavior is not mixed in; output stays reviewable and disposable. Rejected: adding triggers directly to integration-service because the task is investigative and its contract must remain stable."}, {"id": "bkt_jira_triggers_openspec_changes_archive_2026_08_18_add_jira_forge_trigger_demo_design_spec_driven_rather_than_quick_fix", "label": "Decision: spec-driven OpenSpec change rather than quick-fix", "file_type": "rationale", "source_file": "bkt-jira-triggers/openspec/changes/archive/2026-08-18-add-jira-forge-trigger-demo/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "New capability with runtime setup, security boundaries, tests, docs, external Jira Cloud validation and future integration decisions; a quick-fix would hide important safety and acceptance criteria."}, {"id": "bkt_jira_triggers_openspec_changes_archive_2026_08_18_add_jira_forge_trigger_demo_design_empirical_spike_before_final_implementation", "label": "Decision: empirical Forge spike before final implementation", "file_type": "rationale", "source_file": "bkt-jira-triggers/openspec/changes/archive/2026-08-18-add-jira-forge-trigger-demo/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Forge login, runtime support, real payload shape, Jira site permissions and tunnel/log behavior are exactly what the demo must prove, so implementing fully from documentation first was rejected."}, {"id": "bkt_jira_triggers_openspec_changes_archive_2026_08_18_add_jira_forge_trigger_demo_design_minimal_final_trigger_set", "label": "Decision: subscribe only to created and updated issue events", "file_type": "rationale", "source_file": "bkt-jira-triggers/openspec/changes/archive/2026-08-18-add-jira-forge-trigger-demo/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two events satisfy the task with minimal blast radius and small logs; phase 0 may temporarily subscribe to more event families to inspect Object.keys but must revert."}, {"id": "bkt_jira_triggers_openspec_changes_archive_2026_08_18_add_jira_forge_trigger_demo_design_no_egress_by_construction", "label": "Decision: no egress by construction (no permissions.external, remotes or fetch)", "file_type": "rationale", "source_file": "bkt-jira-triggers/openspec/changes/archive/2026-08-18-add-jira-forge-trigger-demo/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Absence of egress configuration is the structural guarantee the prototype cannot call integration-service or anything else; a disabled or mocked fetch was rejected because it weakens the proof."}, {"id": "bkt_jira_triggers_openspec_changes_archive_2026_08_18_add_jira_forge_trigger_demo_design_allowlist_sanitization", "label": "Decision: allowlist sanitization of event logs", "file_type": "rationale", "source_file": "bkt-jira-triggers/openspec/changes/archive/2026-08-18-add-jira-forge-trigger-demo/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Copy only known safe fields and derive metadata from sensitive ones, so unknown future Jira fields cannot leak without a rule per field; summary, description, account ids, display names, emails, avatars, attachments, host URLs and customfield_* values are never logged."}, {"id": "bkt_jira_triggers_openspec_changes_archive_2026_08_18_add_jira_forge_trigger_demo_design_local_contract_builder", "label": "Decision: pure local contract builder buildIssuesRequest (never sends)", "file_type": "rationale", "source_file": "bkt-jira-triggers/openspec/changes/archive/2026-08-18-add-jira-forge-trigger-demo/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Builds and validates the future POST /api/v1/issues payload for exactly one issue, strips forbidden control characters while keeping tab/newline/CR, truncates configured lengths and returns an explicit failure reason; executable validation is stronger evidence than prose while respecting the no-integration boundary."}, {"id": "bkt_jira_triggers_openspec_changes_archive_2026_08_18_add_jira_forge_trigger_demo_design_testing_and_evidence", "label": "Decision: Jest tests plus real Forge log evidence", "file_type": "rationale", "source_file": "bkt-jira-triggers/openspec/changes/archive/2026-08-18-add-jira-forge-trigger-demo/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tests prove local behavior; real logs captured under docs/evidence prove real Jira/Forge capture; both are required for the acceptance criteria."}, {"id": "bkt_jira_triggers_openspec_changes_archive_2026_08_18_add_jira_forge_trigger_demo_design_non_goals", "label": "Non-goals: no integration-service change, no GUI, no real data egress, no Forge egress config, no archive", "file_type": "concept", "source_file": "bkt-jira-triggers/openspec/changes/archive/2026-08-18-add-jira-forge-trigger-demo/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_jira_triggers_openspec_changes_archive_2026_08_18_add_jira_forge_trigger_demo_design_risk_at_least_once_delivery_duplicates", "label": "Risk: at-least-once delivery can duplicate events (needs deduplication/idempotency)", "file_type": "concept", "source_file": "bkt-jira-triggers/openspec/changes/archive/2026-08-18-add-jira-forge-trigger-demo/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_jira_triggers_openspec_changes_archive_2026_08_18_add_jira_forge_trigger_demo_design_risk_forge_logs_delay_and_no_tunnel_output", "label": "Risk: forge logs can lag and does not show tunnel output", "file_type": "concept", "source_file": "bkt-jira-triggers/openspec/changes/archive/2026-08-18-add-jira-forge-trigger-demo/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_jira_triggers_openspec_changes_archive_2026_08_18_add_jira_forge_trigger_demo_design_risk_local_contract_drift", "label": "Risk: local contract copy can drift from integration-service", "file_type": "concept", "source_file": "bkt-jira-triggers/openspec/changes/archive/2026-08-18-add-jira-forge-trigger-demo/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_jira_triggers_openspec_changes_archive_2026_08_18_add_jira_forge_trigger_demo_design_risk_onedrive_path_with_spaces", "label": "Risk: OneDrive path with spaces may break npm install or Forge bundling", "file_type": "concept", "source_file": "bkt-jira-triggers/openspec/changes/archive/2026-08-18-add-jira-forge-trigger-demo/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_jira_triggers_openspec_changes_archive_2026_08_18_add_jira_forge_trigger_demo_design_risk_payload_may_lack_summary", "label": "Risk: trigger payload may lack summary (builder returns MISSING_SUMMARY)", "file_type": "concept", "source_file": "bkt-jira-triggers/openspec/changes/archive/2026-08-18-add-jira-forge-trigger-demo/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_jira_triggers_openspec_changes_archive_2026_08_18_add_jira_forge_trigger_demo_design_open_questions", "label": "Open questions: dev site, nodejs24.x support, real payload fields, admin consent, rate limit", "file_type": "concept", "source_file": "bkt-jira-triggers/openspec/changes/archive/2026-08-18-add-jira-forge-trigger-demo/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_jira_triggers_openspec_changes_archive_2026_08_18_add_jira_forge_trigger_demo_design_migration_plan_and_rollback", "label": "Migration plan: none for production; rollback is deleting demo artifacts", "file_type": "concept", "source_file": "bkt-jira-triggers/openspec/changes/archive/2026-08-18-add-jira-forge-trigger-demo/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "bkt_jira_triggers_openspec_changes_archive_2026_08_18_add_jira_forge_trigger_demo_design", "target": "bkt_jira_triggers_openspec_changes_archive_2026_08_18_add_jira_forge_trigger_demo_design_standalone_forge_project", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "bkt-jira-triggers/openspe