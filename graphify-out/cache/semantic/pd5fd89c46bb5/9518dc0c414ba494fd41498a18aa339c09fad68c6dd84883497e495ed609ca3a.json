{"nodes": [{"id": "bkt_integration_service_openspec_changes_archive_2026_08_07_endurecer_especificacion_openapi_42crunch_specs_openapi_schema_hardening_spec", "label": "openapi-schema-hardening spec (round 1, 2026-08-07)", "file_type": "document", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-07-endurecer-especificacion-openapi-42crunch/specs/openapi-schema-hardening/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_07_endurecer_especificacion_openapi_42crunch_specs_openapi_schema_hardening_spec_own_response_schemas_strict", "label": "Own response schemas reject unknown properties", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-07-endurecer-especificacion-openapi-42crunch/specs/openapi-schema-hardening/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "additionalProperties:false only on response schemas whose full property set is defined and controlled by this service (ExecutionError, AttachedDocument, IssueInfo, IssueProcessResult, IssueProcessSummary, IssueProcessResponse, IssueAcceptedResponse, ErrorResponse, RateLimitErrorResponse, HealthResponse, ApiRootResponse)."}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_07_endurecer_especificacion_openapi_42crunch_specs_openapi_schema_hardening_spec_mapping_driven_schemas_open", "label": "Mapping-driven and echoed schemas remain open", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-07-endurecer-especificacion-openapi-42crunch/specs/openapi-schema-hardening/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "IssueContent (with technicianInfo), IssuePayload, IssueBatchRequest and nested fields/issuetype have a contract driven by external data (MongoDB mappings entries, echoed Jira payloads); restricting additionalProperties would document a false restriction."}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_07_endurecer_especificacion_openapi_42crunch_specs_openapi_schema_hardening_spec_doc_only_string_pattern", "label": "Documentation-only string fields declare maxLength and control-character-safe pattern", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-07-endurecer-especificacion-openapi-42crunch/specs/openapi-schema-hardening/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_07_endurecer_especificacion_openapi_42crunch_specs_openapi_schema_hardening_spec_runtime_validator_strings_length_only", "label": "Runtime validator strings: length ceiling without content pattern", "file_type": "rationale", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-07-endurecer-especificacion-openapi-42crunch/specs/openapi-schema-hardening/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The 5 fields validating real Jira/TC payloads (issuePayload.id, issuePayload.key, fields.summary, fields.issuetype.name, issueBatch.initiatedBy) get only a generous maxLength so legitimate ingestion is never rejected; superseded in round 2."}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_07_endurecer_especificacion_openapi_42crunch_specs_openapi_schema_hardening_spec_error_status_code_range", "label": "ErrorResponse.error.statusCode limited to 100-599", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-07-endurecer-especificacion-openapi-42crunch/specs/openapi-schema-hardening/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_07_endurecer_especificacion_openapi_42crunch_specs_openapi_schema_hardening_spec_response_array_size_bounds", "label": "Response arrays declare size bounds tied to business rules", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-07-endurecer-especificacion-openapi-42crunch/specs/openapi-schema-hardening/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "errors max 50, tickets exactly 1, attachedDocuments max 100, actions max 200; tickets length mirrors the one-ticket-per-request rule already enforced on the request side."}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_07_endurecer_especificacion_openapi_42crunch_specs_openapi_schema_hardening_spec_one_ticket_per_request_rule", "label": "One-ticket-per-request rule (IssueBatchRequest.issues length 1)", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-07-endurecer-especificacion-openapi-42crunch/specs/openapi-schema-hardening/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_07_endurecer_especificacion_openapi_42crunch_specs_openapi_schema_hardening_spec_issue_content_schema", "label": "IssueContent schema", "file_type": "concept", "source_file": "bkt-integration-service/openspec/changes/archive/2026-08-07-endurecer-especificacion-openapi-42crunch/specs/openapi-schema-hardening/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bkt_integration_service_openspec_changes_archive_2026_08_07_endurecer_especificacion_openapi_42crunch_specs_openapi_schema_hardening_spec_issue_payload_schema", "label": "IssuePayload and Iss