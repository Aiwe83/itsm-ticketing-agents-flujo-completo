# Runtime variables used by the Forge trigger when the integration dispatch is enabled.
# Do not store real secrets in this file.

# HTTPS base URL of bkt-integration-service, without a trailing /api/v1/issues path.
# Example for local demos through ngrok:
INTEGRATION_SERVICE_BASE_URL=https://example.ngrok-free.dev

# Secret API key expected by bkt-integration-service.
# Configure the real value in Forge as an encrypted variable.
INTEGRATION_SERVICE_API_KEY=<set-in-forge-as-encrypted-variable>

# Header name expected by bkt-integration-service. Keep the default unless the service changes.
INTEGRATION_SERVICE_API_KEY_HEADER=X-API-KEY
